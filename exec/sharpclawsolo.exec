### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
### ~~~~ STEP 10: KAT and selfhom file generation for DepthKopy and Diploidocus ~~~~ ###
## Goal: 
## Approach: 
## Rationale: 
## Method: 
## Key inputs: 
## Key outputs: 
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
STEP=KAT
KEYOUT=$NEWBASE.hap2.self.bam
KEYOUTS="$NEWBASE.hap1.self.bam $NEWBASE.hap2.self.bam"
if [ ! -f "$KEYOUT" ]; then

# Define key new variables

# Execute code for step
#i# Create *.kat-stats.tsv and *.kat-counts.cvg
for HAP in hap1 hap2; do
  if [ ! -f "$NEWBASE.$HAP.self.bam" ]; then
	#a# $KMERREADS
	if [ "$TRIM10X" = "T" ]; then
		singularity run $SING/kat:2.4.1.sif kat sect -t $THREADS --5ptrim 16,0 -o $NEWBASE.$HAP.kat $NEWBASE.$HAP.fasta ${KMERREADS/,/ }
	else
		singularity run $SING/kat:2.4.1.sif kat sect -t $THREADS -o $NEWBASE.$HAP.kat $NEWBASE.$HAP.fasta ${KMERREADS/,/ }	
	fi
	#b# Self
	singularity run $SING/kat:2.4.1.sif kat sect -t $THREADS -o $NEWBASE.$HAP.self.kat $NEWBASE.$HAP.fasta $NEWBASE.$HAP.fasta
	#c# Alt
    ALTGENOME=$NEWBASE.hap1.fasta
    if [ "$HAP" == "hap1" ]; then
    	ALTGENOME=$NEWBASE.hap2.fasta
    fi
	singularity run $SING/kat:2.4.1.sif kat sect -t $THREADS -o $NEWBASE.$HAP.alt.kat $NEWBASE.$HAP.fasta $ALTGENOME
	#i# Create self homology file
	MMSETTINGS="-aDP -I 4G -k19 -w19 -m200"
	singularity run $SING/minimap2:2.26.sif minimap2 -t $THREADS $MMSETTINGS $NEWBASE.$HAP.fasta $NEWBASE.$HAP.fasta | \
		singularity run $SING/depthsizer:v1.9.0.sif samtools view -b -h - | \
		singularity run $SING/depthsizer:v1.9.0.sif samtools sort - | tee $NEWBASE.$HAP.self.bam | \
    	singularity run $SING/depthsizer:v1.9.0.sif samtools flagstat - 
    singularity run $SING/depthsizer:v1.9.0.sif samtools index -b $NEWBASE.$HAP.self.bam $NEWBASE.$HAP.self.bam.bai
  fi
done

touch $STEP.done

else
	echo "[$(date)] File found: $KEYOUT - skipping $STEP step" | tee -a $LOG
fi
# Check for key output files
for KEYOUT in $KEYOUTS; do
	if [ ! -f "$KEYOUT" ]; then
		echo "[$(date)] Failed to generate $KEYOUT" | tee -a $LOG
		exit 1
	fi
done



### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
### ~~~~ STEP 11: DepthKopy CN estimation for ChromSyn plots.                   ~~~~ ###
## Goal: 
## Approach: 
## Rationale: 
## Method: 
## Key inputs: 
## Key outputs: 
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
STEP=DepthKopy
KEYOUT=$NEWBASE.hap2.fulltable.csv
KEYOUTS="$NEWBASE.hap1.fulltable.csv $KEYOUT"
if [ ! -f "$KEYOUT" ]; then

# Define key new variables
#i# DepthKopy can run out of memory with 32 threads and 56G memory. 
#i# Reducing the thread count here. Might need to set as a new config setting.
#i# Will try re-running without the KAT data if fails to complete.
FORKS=$(($NCPU/2))
# Execute code for step
#i# Run DepthKopy
for HAP in hap1 hap2; do
  if [ ! -f "$NEWBASE.$HAP.fulltable.csv" ]; then
    GENBASE=$NEWBASE.$HAP
    BUSCO=$GENBASE.$ODB10.full_table.tsv
    BAM=$GENBASE.$READTYPE.bam
    CONTIGS=$GENBASE.contigs.tdt
    ALTGENOME=$NEWBASE.hap1.fasta
    if [ "$HAP" == "hap1" ]; then
    	ALTGENOME=$NEWBASE.hap2.fasta
    fi
    # Try with CSI indexing if BAM.bai missing
    if [ ! -f "$BAM.bai" ]; then
    	singularity run $SING/depthsizer:v1.9.0.sif python3 $SLIMSUITE/tools/depthkopy.py -threads $FORKS -seqin $GENBASE.fasta -basefile $GENBASE -busco $BUSCO -bam $BAM kmerreads="$KMERREADS" kmeralt=$ALTGENOME regfile=Contigs:$CONTIGS reghead=seqname,start,end i=-1 v=0 bamcsi=T
    else
		singularity run $SING/depthsizer:v1.9.0.sif python3 $SLIMSUITE/tools/depthkopy.py -threads $FORKS -seqin $GENBASE.fasta -basefile $GENBASE -busco $BUSCO -bam $BAM kmerreads="$KMERREADS" kmeralt=$ALTGENOME regfile=Contigs:$CONTIGS reghead=seqname,start,end i=-1 v=0
	fi
	# Try re-running without the KAT data if the run failed.
    if [ ! -f "$NEWBASE.$HAP.fulltable.csv" ]; then
    	echo "DepthKopy run failed. Possible memory problems? Will try without KAT data. If problems remain, try increasing memory requested."
        if [ ! -f "$BAM.bai" ]; then
    		singularity run $SING/depthsizer:v1.9.0.sif python3 $SLIMSUITE/tools/depthkopy.py -threads $FORKS -seqin $GENBASE.fasta -basefile $GENBASE -busco $BUSCO -bam $BAM kmerreads= kmeralt=None kmerself=F regfile=Contigs:$CONTIGS reghead=seqname,start,end i=-1 v=0 bamcsi=T
	    else
			singularity run $SING/depthsizer:v1.9.0.sif python3 $SLIMSUITE/tools/depthkopy.py -threads $FORKS -seqin $GENBASE.fasta -basefile $GENBASE -busco $BUSCO -bam $BAM kmerreads= kmeralt=None kmerself=F regfile=Contigs:$CONTIGS reghead=seqname,start,end i=-1 v=0
		fi
	fi
	
  fi
done

touch $STEP.done

else
	echo "[$(date)] File found: $KEYOUT - skipping $STEP step" | tee -a $LOG
fi
# Check for key output files
for KEYOUT in $KEYOUTS; do
	if [ ! -f "$KEYOUT" ]; then
		echo "[$(date)] WARNING: Failed to generate $KEYOUT - some later stages may be affected" | tee -a $LOG
	fi
done


### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
### ~~~~ STEP 12: SynBad Gap classification.                                    ~~~~ ###
## Goal: 
## Approach: 
## Rationale: 
## Method: 
## Key inputs: 
## Key outputs: 
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
STEP=SynBad
KEYOUT=$NEWBASE.synbad.hit.gap.tdt
KEYOUTS="$NEWBASE.synbad.qry.gap.tdt $NEWBASE.synbad.hit.gap.tdt"
if [ ! -f "$KEYOUT" ]; then

# Define key new variables
BASE1=$NEWBASE.hap1
BASE2=$NEWBASE.hap2
ls -lrth $BASE1.fasta $BASE1.$READTYPE.bam $BASE1.$READTYPE.paf $BASE1.$ODB10.full_table.tsv $BASE1.mapped.PT.bam
ls -lrth $BASE2.fasta $BASE2.$READTYPE.bam $BASE2.$READTYPE.paf $BASE2.$ODB10.full_table.tsv $BASE2.mapped.PT.bam
# 
# Run SynBad
singularity run $SING/depthsizer:v1.9.0.sif python3 $SLIMSUITE/tools/synbad.py genome1=$BASE1.fasta bam1=$BASE1.$READTYPE.bam paf1=$BASE1.$READTYPE.paf hicbam1=$BASE1.mapped.PT.bam busco1=$BASE1.$ODB10.full_table.tsv genome2=$BASE2.fasta bam2=$BASE2.$READTYPE.bam paf2=$BASE2.$READTYPE.paf hicbam2=$BASE2.mapped.PT.bam busco2=$BASE2.$ODB10.full_table.tsv basefile=$NEWBASE.synbad chr1=$PREF1 chr2=$PREF2 correct=invert spannedflank=100 synreadspan=3 i=-1 v=0 threads=$THREADS

touch $STEP.done

else
	echo "[$(date)] File found: $KEYOUT - skipping $STEP step" | tee -a $LOG
fi
# Check for key output files
for KEYOUT in $KEYOUTS; do
	if [ ! -f "$KEYOUT" ]; then
		echo "[$(date)] Failed to generate $KEYOUT" | tee -a $LOG
		exit 1
	fi
done



### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
### ~~~~ STEP 13: Detailed ChromSyn plots with DepthCharge, CN and SynBad       ~~~~ ###
## Goal: 
## Approach: 
## Rationale: 
## Method: 
## Key inputs: 
## Key outputs: 
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
STEP=ChromSynBad
KEYOUT=
KEYOUTS="$KEYOUT"
if [ ! -f "$KEYOUT" ]; then

# Define key new variables

# Execute code for step
echo "Generating updated gaps and features files..."
cp -v $NEWBASE.synbad.qry.gap.tdt $NEWBASE.hap1.synbadgaps.tsv
cp -v $NEWBASE.synbad.hit.gap.tdt $NEWBASE.hap2.synbadgaps.tsv
for BASE in $NEWBASE.hap1 $NEWBASE.hap2; do
	cp -v $BASE.rrna.csv $BASE.ft.csv
	grep bad $BASE.depthcharge.tdt | awk '{print $1","$2","$3",.,black,-2";}' | tee -a $BASE.ft.csv
done
#i# Colour sequences by type
for HAP in hap1 hap2; do
	TFILE=$NEWBASE.$HAP.telomeres.tdt
	TSV=$NEWBASE.$HAP.sequences.tsv
	head -n 1 $TFILE | awk '{print $1"\t"$2"\t"$3"\t"$4"\tCol";}' | tee $TSV
	grep -E "CHR[0-9]+[^\.]" $TFILE | awk '{print $1"\t"$2"\t"$3"\t"$4"\tpalegreen";}' | tee -a $TSV
	grep -E "CHR[0-9]+\." $TFILE | awk '{print $1"\t"$2"\t"$3"\t"$4"\tyellow2";}' | tee -a $TSV
	grep SCF $TFILE | awk '{print $1"\t"$2"\t"$3"\t"$4"\ttan";}' | tee -a $TSV
	grep CTG $TFILE | awk '{print $1"\t"$2"\t"$3"\t"$4"\tivory2";}' | tee -a $TSV
done
#i# Update FOFN
for FOFNDATA in ft.csv-fullft synbadgaps.tsv-synbad sequences.tsv-colseq; do
	EXT=$(echo $FOFNDATA | awk -F '-' '{print $1;}')
	FOFN=$(echo $FOFNDATA | awk -F '-' '{print $2;}').fofn
	sed "s/$/.$EXT/" template.fofn | tee $FOFN
done
#i# CN data
cat $NEWBASE.hap[12].fulltable.tsv | head -n 1 > $NEWBASE.cndata.tsv
sed 's/^/$PREF1\t/' $NEWBASE.hap1.fulltable.tsv | grep -v SeqName >> $NEWBASE.cndata.tsv
sed 's/^/$PREF2\t/' $NEWBASE.hap2.fulltable.tsv | grep -v SeqName >> $NEWBASE.cndata.tsv

echo "Generating regdata file for ChromSyn from 1kb+ SynBad hit regions..."
QRY=$PREF1; HIT=$PREF2
TSV=$NEWBASE.regdata.tsv
echo "Genome, HitGenome, SeqName, Start, End, Strand, Hit, HitStart, HitEnd" | sed "s/, /\t/g" | tee $TSV
awk '$9 > 1000 { print $1"\t"$2"\t"$3"\t"$7"\t"$4"\t"$5"\t"$6; }' $NEWBASE.synbad.qry.full.tdt | sed "s/^/$PREF1\t$PREF2\t/" | grep -v Qry | tee -a $TSV
awk '$9 > 1000 { print $4"\t"$5"\t"$6"\t"$7"\t"$1"\t"$2"\t"$3; }' $NEWBASE.synbad.hit.full.tdt | sed "s/^/$PREF2\t$PREF1\t/" | grep -v Qry | tee -a $TSV

echo "Full assembly ChromSyn plot in QC mode with 'good' gaps hidden"
FOCUS=$QRY
SEQORDER=$(grep CHR $NEWBASE.hap1.sequences.tsv | awk '{print $1;}' | sort | tr '\n' ',' | sed 's/,$//')
RESTRICT=$(cat $NEWBASE.hap[12].sequences.tsv | grep CHR | awk '{print $1;}' | sort | tr '\n' ',' | sed 's/,$//')
SETTINGS="pdfwidth=40 orphans=FALSE ticks=1e7 minlen=0 maxregions=8000 regdata=$NEWBASE.regdata.tsv minregion=0 ybleed=1 focus=$FOCUS seqorder=$SEQORDER chromfill=Col regmirror=F sequences=colseq.fofn gaps=synbad.fofn ft=fullft.fofn cndata=$NEWBASE.cndata.tsv restrict=$RESTRICT"
echo $SETTINGS
RUN=$NEWBASE
BASE=qcmode
singularity run $SING/depthsizer:v1.9.0.sif Rscript $SLIMSUITE/libraries/r/chromsyn.R $SETTINGS basefile=$RUN.$BASE qcmode=T | tee $RUN.$BASE.log

echo "Chromosome-level ChromSyn plots"
for CHR in $(grep -E "CHR[0-9]+[^\.]" $NEWBASE.hap1.telomeres.tdt | awk '{print $1;}' | sed "s/$PREF1//" | sort -u); do
	BASE=$CHR
	RESTRICT=$(cat $NEWBASE.hap[12].sequences.tsv | grep CHR$CHR | awk '{print $1;}' | sort | tr '\n' ',' | sed 's/,$//')
	echo "$CHR: $RESTRICT"
	singularity run $SING/depthsizer:v1.9.0.sif Rscript $SLIMSUITE/libraries/r/chromsyn.R $SETTINGS basefile=$RUN.$BASE restrict=$RESTRICT | tee $RUN.$BASE.log
done

touch $STEP.done

else
	echo "[$(date)] File found: $KEYOUT - skipping $STEP step" | tee -a $LOG
fi
# Check for key output files
for KEYOUT in $KEYOUTS; do
	if [ ! -f "$KEYOUT" ]; then
		echo "[$(date)] Failed to generate $KEYOUT" | tee -a $LOG
		exit 1
	fi
done



### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
### ~~~~ STEP 14: Diploidocus classification for reduced PreText.               ~~~~ ###
## Goal: 
## Approach: 
## Rationale: 
## Method: 
## Key inputs: 
## Key outputs: 
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
STEP=Diploidocus
KEYOUT=$NEWBASE.hap2.ratings.tdt
KEYOUTS="$NEWBASE.hap1.ratings.tdt $NEWBASE.hap2.ratings.tdt"
if [ ! -f "$KEYOUT" ]; then

# Define key new variables

# Execute code for step
for HAP in hap1 hap2; do
    GENBASE=$NEWBASE.$HAP
    BUSCO=$GENBASE.$ODB10.full_table.tsv
    BAM=$GENBASE.$READTYPE.bam
    #i# Need to pre-run purge_haplotigs:1.1.2.sif
    echo "Running $HAP purge_haplotigs for Diploidocus..."
    SCDEP=$(printf "%.0f" "$(cat $BAM.fastmp.scdepth)")
    PHLOW=$(($SCDEP/4))
    PHMID=$((3*$SCDEP/4))
    PHHIGH=$((2*$SCDEP))
    echo "$HAP: Low=${PHLOW}X; Mid=${PHMID}X; High=${PHHIGH}X; SC=${SCDEP}X)"
    PHMAX=200
    if [ $PHHIGH gt 100 ]; then
    	$PHMAX=$((2*$PHHIGH))
    fi
	PHDIR=purge_$GENBASE
	singularity run $SING/purge_haplotigs:1.1.2.sif purge_haplotigs hist -b $BAM -g $GENBASE.fasta -t $THREADS -d $PHMAX \
		&& singularity run $SING/purge_haplotigs:1.1.2.sif purge_haplotigs cov -i $BAM.gencov -l $PHLOW -m $PHMID -h $PHHIGH -o $GENBASE.purge.coverage_stats.csv -j 80 -s 80 \
		&& singularity run $SING/purge_haplotigs:1.1.2.sif purge_haplotigs purge -g $GENBASE.fasta -c $GENBASE.purge.coverage_stats.csv -t $THREADS -o $GENBASE.purge -a 95
    echo "Running $HAP Diploidocus..."
    # Try with CSI indexing if BAM.bai missing
    if [ ! -f "$BAM.bai" ]; then
		singularity run $SING/depthsizer:v1.9.0.sif python3 $SLIMSUITE/tools/diploidocus.py -seqin $GENBASE.fasta -basefile $GENBASE -busco $BUSCO -bam $BAM kmerreads=$KMERREADS -threads $THREADS -runmode diploidocus -pretrim F -veccheck F i=-1 v=0 bamcsi=T
	else
		singularity run $SING/depthsizer:v1.9.0.sif python3 $SLIMSUITE/tools/diploidocus.py -seqin $GENBASE.fasta -basefile $GENBASE -busco $BUSCO -bam $BAM kmerreads=$KMERREADS -threads $THREADS -runmode diploidocus -pretrim F -veccheck F i=-1 v=0
	fi	
done

touch $STEP.done

else
	echo "[$(date)] File found: $KEYOUT - skipping $STEP step" | tee -a $LOG
fi
# Check for key output files
for KEYOUT in $KEYOUTS; do
	if [ ! -f "$KEYOUT" ]; then
		echo "[$(date)] Failed to generate $KEYOUT" | tee -a $LOG
		exit 1
	fi
done




### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
### ~~~~ STEP 15: Reduced PreText generation without repeat scaffolds.          ~~~~ ###
## Goal: 
## Approach: 
## Rationale: 
## Method: 
## Key inputs: 
## Key outputs: 
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
STEP=ReducedPreText
KEYOUT=$NEWBASE.dip.diploidocus.map.pretext
KEYOUTS="$KEYOUT"
if [ ! -f "$KEYOUT" ] && [ -f "$NEWBASE.dip.mapped.PT.bam" ]; then

# Define key new variables
PTBAM=$NEWBASE.dip.mapped.PT.bam

# Execute code for step
echo "Defining BED files for $NEWBASE reduced PreText..."
cat $NEWBASE.hap[12].ratings.tdt | grep keep | awk '{print $1"\t1\t"$2;}' > $NEWBASE.diploidocus.bed
cp $NEWBASE.diploidocus.bed $NEWBASE.nojunk.bed
cat $NEWBASE.hap[12].ratings.tdt | grep quarantine | awk '{print $1"\t1\t"$2;}' >> $NEWBASE.nojunk.bed
cp $NEWBASE.nojunk.bed $NEWBASE.norepeat.bed
cat $NEWBASE.hap[12].ratings.tdt | grep junk | awk '{print $1"\t1\t"$2;}' >> $NEWBASE.norepeat.bed
echo "Reduced PT BAM files and PreText"
for BED in norepeat nojunk diploidocus; do
	singularity run $SING/depthsizer:v1.9.0.sif samtools view -h -@ $THREADS -L $NEWBASE.$BED.bed $PTBAM > $NEWBASE.$BED.PT.bam | \
		singularity run $SING/pretextmap:0.1.9.sif PretextMap -o "$NEWBASE.dip.$BED.map.pretext" --sortby nosort \
		&& singularity run $SING/pretextsnapshot:0.0.4.sif PretextSnapshot -m "$NEWBASE.dip.$BED.map.pretext" -o "$NEWBASE.dip.$BED.output" --prefix $NEWBASE.dip.${BED}_snapshot
done

touch $STEP.done

else
	if [ -f "$NEWBASE.dip.mapped.PT.bam" ]; then
		echo "[$(date)] $NEWBASE.dip.mapped.PT.bam not yet generated - skipping $STEP step" | tee -a $LOG
	else
		echo "[$(date)] File found: $KEYOUT - skipping $STEP step" | tee -a $LOG
	fi
fi
# Check for key output files
for KEYOUT in $KEYOUTS; do
	if [ ! -f "$KEYOUT" ]; then
		echo "[$(date)] Failed to generate $KEYOUT" | tee -a $LOG
		exit 1
	fi
done
####################################### ::: FINISH ::: #############################################
echo "#---------------" | tee -a $LOG
echo "[$(date)]: Run complete" | tee -a $LOG
echo "#---------------" | tee -a $LOG
exit 0

