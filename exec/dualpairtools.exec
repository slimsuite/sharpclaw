# Recommended resources: 48 PPN; 96G memory
# The following variables should be set:
# >> $GENOME = fasta file to map reads onto
# >> $HIC1 = R1 HiC fastq.gz
# >> $HIC2 = R1 HiC fastq.gz

#---------------
# Activate conda environment 
source /software/projects/pawsey0812/edejong/mamba/etc/profile.d/conda.sh
conda activate pairtools

#---------------
# Define path to temp directory
GENBASE=$(basename ${GENOME%.*})
TMPDIR=$(pwd)/tmp$GENBASE
mkdir $TMPDIR
echo "Temp dir: $TMPDIR"

# --------------
# Run the Omni-C pipeline
## 1. Create an index for reference - samtools faidx
## 2. Use the index to generate a genome file - cut
## 3. Generate bwa index files - bwa index
## 4. Alignment - bwa mem
## 5. Recording valid ligation events - pairtools parse
## 6. Sorting the pairsam file - pairtools sort
## 7. Removig PCR duplicates - pairtools dedup
## 8. Generating .pairs and bam files
## 9. Generating the final bam file
## 10. Index the bam file
GENBASE=$(basename ${GENOME%.*})
PTBAM=$GENBASE.mapped.PT.bam

echo "Assembly: $GENOME"
echo "Generating: $PTBAM"
samtools faidx $GENOME \
&& cut -f1,2 $GENOME.fai > "$GENBASE.genome" \
&& bwa index $GENOME \
&& bwa mem -5SP -T0 -t64 $GENOME $HIC1 $HIC2 -o "$GENBASE.aligned.sam" \
&& pairtools parse --min-mapq 0 --walks-policy 5unique --max-inter-align-gap 30 --nproc-in 24 --nproc-out 24 --chroms-path "$GENBASE.genome" "$GENBASE.aligned.sam" >  "$GENBASE.parsed.pairsam" \
&& pairtools sort --nproc 48 --tmpdir=$TMPDIR  "$GENBASE.parsed.pairsam" > "$GENBASE.sorted.pairsam" \
&& pairtools dedup --nproc-in 24 --nproc-out 24 --mark-dups --output-stats "$GENBASE.stats.txt" --output "$GENBASE.dedup.pairsam" "$GENBASE.sorted.pairsam" \
&& pairtools split --nproc-in 24 --nproc-out 24 --output-pairs "$GENBASE.mapped.pairs" --output-sam "$GENBASE.unsorted.bam" "$GENBASE.dedup.pairsam" \
&& samtools sort -@48 -T  "$TMPDIR/temp.bam" -o "$GENBASE.mapped.PT.bam" "$GENBASE.unsorted.bam" \
&& samtools index $PTBAM $PTBAM.bai

# --------------
# Cleanup the output files
if [ -f "$PTBAM" ]; then
	echo "[$(date)] Cleaning up PairTools intermediates..."
	rm -v $GENBASE.*sam $GENBASE.mapped.pairs $GENBASE.unsorted.bam
	rm -rvf $TMPDIR/ 
	for EXT in bwt amb ann pac sa; do
		rm -v $GENOME.$EXT
	done
fi

#---------------
#Successfully finished
ls -lrth $GENBASE.*
