#i# NOTE: This will prevent re-running of the workflow, so make it a toggle.

####################################### ::: FINISH ::: #############################################
echo "#---------------" | tee -a $LOG
echo "[$(date)]: Run complete" | tee -a $LOG
echo "#---------------" | tee -a $LOG
exit 0

