####################################### ::: SETUP ::: ##############################################

### ~~~~~~~ Fix settings ~~~~~~~~ ###
#i# These are settings introduced during development that will ultimately be in the config file.
if [ -z "$DEPTHKOPYCN" ]; then
	DEPTHKOPYCN=TRUE
fi
if [ -z "$DKFORKS" ]; then
	DKFORKS=$(($NCPU/2))
fi
if [ -z "$CLEANUP" ]; then
	if [ "$DEV" = "TRUE" ]; then
		CLEANUP=backup
	else
		CLEANUP=delete
	fi
fi
# if [ -z "$BACKUPDIR" ]; then
# 	BACKUPDIR=sharpclaw_intermed
# fi
# if [ "$CLEANUP" = "backup" ] && [ ! -d "$BACKUPDIR" ]; then
# 	mkdir -vp $BACKUPDIR
# fi

### ~~~~~~~~~~ Set variables ~~~~~~~~~~ ###
HAPBASE1=$(basename ${HAP1%.*})
HAPBASE2=$(basename ${HAP2%.*})
RUNDIR=$(pwd)

##################################### ::: PREFLIGHT CHECKS ::: #######################################
echo "[$(date)] Preflight checks of dependencies..."
#i# SLiMSuite tools
for TOOL in telociraptor seqsuite; do
	TESTV=$(python3 $SLIMSUITE/tools/$TOOL.py --version) && echo "[$(date)] $TOOL: v$TESTV"
	if [ -z "$TESTV" ]; then
		echo "ERROR! Cannot run: python3 $SLIMSUITE/tools/$TOOL.py"; exit 1
	fi
done
#i# Minimap2
TESTV=$($MINIMAP2 --version) && echo "[$(date)] Minimap2: v$TESTV"
if [ -z "$TESTV" ]; then
	echo "ERROR! Cannot run: $MINIMAP2"; exit 1
fi
#i# Compleasm
TESTV=$($COMPLEASM --help) && TESTV="found" && echo "[$(date)] Compleasm: $TESTV"
if [ -z "$TESTV" ]; then
	echo "ERROR! Cannot run: $COMPLEASM"; exit 1
fi
#i# Barrnap
TESTV=$($BARRNAP --version) && TESTV="found" && echo "[$(date)] barrnap: $TESTV"
if [ -z "$TESTV" ]; then
	echo "ERROR! Cannot run: $BARRNAP"; exit 1
fi
#i# TIDK
TESTV=$($TIDK --version) && echo "[$(date)] TIDK: $TESTV"
if [ -z "$TESTV" ]; then
	echo "ERROR! Cannot run: $TIDK"; exit 1
fi
#i# Rscript
TESTV=$($RSCRIPT --version) && echo "[$(date)] Rscript: $TESTV"
if [ -z "$TESTV" ]; then
	echo "ERROR! Cannot run: $RSCRIPT"; exit 1
fi
#i# samtools
TESTV=$($SAMTOOLS --version | head -n 1) && echo "[$(date)] samtools: $TESTV"
if [ -z "$TESTV" ]; then
	echo "ERROR! Cannot run: $SAMTOOLS"; exit 1
fi
#i# paftools
TESTV=$($PAFTOOLS version) && echo "[$(date)] paftools: v$TESTV"
if [ -z "$TESTV" ]; then
	echo "ERROR! Cannot run: $PAFTOOLS"; exit 1
fi
#i# DepthCharge
TESTV=$($DEPTHCHARGE --version) && echo "[$(date)] DepthCharge: v$TESTV"
if [ -z "$TESTV" ]; then
	echo "ERROR! Cannot run: $DEPTHCHARGE"; exit 1
fi
#i# DepthKopy
TESTV=$($DEPTHKOPY --version) && echo "[$(date)] DepthKopy: v$TESTV"
if [ -z "$TESTV" ]; then
	echo "ERROR! Cannot run: $DEPTHKOPY"; exit 1
fi
#i# KAT
TESTV=$($KAT --version) && echo "[$(date)] KAT: $TESTV"
if [ -z "$TESTV" ]; then
	echo "ERROR! Cannot run: $KAT"; exit 1
fi
#i# SynBad
TESTV=$($SYNBAD --version) && echo "[$(date)] SynBad: v$TESTV"
if [ -z "$TESTV" ]; then
	echo "ERROR! Cannot run: $SYNBAD"; exit 1
fi
#i# purge_haploptigs
TESTV=$($PURGEHAPLOTIGS 2>&1 | grep Purge | head -n1 ) && echo "[$(date)] purge_haploptigs: $TESTV"
if [ -z "$TESTV" ]; then
	echo "ERROR! Cannot run: $PURGEHAPLOTIGS"; exit 1
fi
#i# bbmap pileup.sh
TESTV=$($BBMAPPILEUP --version | head -n 1) && TESTV="found" && echo "[$(date)] bbmap pileup.sh: $TESTV"
if [ -z "$TESTV" ]; then
	echo "ERROR! Cannot run: $BBMAPPILEUP"; exit 1
fi
#i# Diploidocus
TESTV=$($DIPLOIDOCUS --version) && echo "[$(date)] Diploidocus: v$TESTV"
if [ -z "$TESTV" ]; then
	echo "ERROR! Cannot run: $DIPLOIDOCUS"; exit 1
fi
#i# PreTextMap
TESTV=$($PRETEXTMAP | head -n 1) && TESTV="found" && echo "[$(date)] PreTextMap: $TESTV"
if [ -z "$TESTV" ]; then
	echo "ERROR! Cannot run: $PRETEXTMAP"; exit 1
fi
#i# PretextSnapshot
TESTV=$($PRETEXTSNAPSHOT --version | head -n 1) && echo "[$(date)] PretextSnapshot: $TESTV"
if [ -z "$TESTV" ]; then
	echo "ERROR! Cannot run: $PRETEXTSNAPSHOT"; exit 1
fi

####################################### ::: SHARPCLAW ::: ##############################################

### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
### ~~~~ STEP 1: Telociraptor chromsort of the hap1 assembly. ~~~~ ###
## Goal: Sorts scaffolds by length and labels chromosomes.
## Rationale: Final chromsosomes will be sorted by length. Clear labels makes combining and curating data easier.
## Method: Telociraptor sorting of scaffolds and assigning putative chromosomes based on length.
## Key inputs: Hap1 Genome Assembly ($HAP1)
## Key outputs: 
## - Sorted and tweaked assembly ($NEWBASE.chromsort.tweak.fasta)
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
STEP=01-Telociraptor
START="[$(date)] Step $STEP"
KEYOUT=$NEWBASE.chromsort.tweak.fasta
if [ ! -f "$KEYOUT" ]; then

	#i# Run Telociraptor on Hap1
	echo "[$(date)] size-sorting and renaming Hap1 with Telociraptor..."
	python3 $SLIMSUITE/tools/telociraptor.py -seqin $HAP1 -chromsort -minchrom $MINCHROM -basefile $NEWBASE.chromsort -newprefix $PREF1 i=-1 v=0 log=$LOG \
		&& echo -e "$START\n[$(date)] Step $STEP complete" | tee $STEP.done
 
else
	echo "[$(date)] File found: $KEYOUT - skipping $STEP step"
fi
# Check for key output file
if [ ! -f "$KEYOUT" ]; then
	echo "[$(date)] Failed to generate $KEYOUT"
	exit 1
fi
# Move unwanted files to intermediate directory
for EXT in gaplen.tdt gaps.tdt contigs.tdt contigs.fasta.* telomeres.tdt; do
	$SHARPCLAW/exec/backupfile.exec $HAPBASE1.$EXT $STEP
done
if [ -f "$NEWBASE.chromsort.tweak.telomeres.tdt" ]; then
	mv -v $NEWBASE.chromsort.* $STEP/
	cp -v $STEP/$KEYOUT .
fi
# Outputs:
# ├── $NEWBASE.chromsort.tweak.fasta
if [ "$RUNMODE" = "$STEP" ]; then
	echo "[$(date)] RUNMODE=$RUNMODE -> Exiting run." | tee -a $LOG
	exit 0;
fi


### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
### ~~~~ STEP 2: PAFScaff scaffold each haplotype against the primary assembly. ~~~~ ###
## Goal: Orient and rename the scaffolds of each haplotype to facilitate dual curation of HiC map
## Rationale: Curation is easier if sequences are named and oriented consistently.
## Method: 	Hap2 is first mapped onto the chromosome-sorted Hap1 from Telociraptor. This will reorient and rename the
## 			main chromosome scaffolds to match between the haplotypes. Any unplaced scaffolds from Hap2 with clear 
## 			(unique) mapping to Hap1 chromosomes will also be reoriented and renames appropriately. The orignal Hap1
##			is then mapped back onto this renamed Hap2 to pick up any of its unplaced scaffolds that belong together.
##			Note that when there are chromosome fusions, the CHR numbering will be wrong, but everything should end up
##			together for easier curation in PreText
## Key inputs: Hap2 Genome Assembly ($HAP2) and sorted $HAP1 assembly
## Key outputs: Sorted assemblies and summary ($NEWBASE.summarise.tdt)
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
STEP=02-PAFScaff
START="[$(date)] Step $STEP"
KEYOUT="$NEWBASE.summarise.tdt"
KEYOUTS="$KEYOUT $HAPBASE1.sorted.fasta $HAPBASE2.sorted.fasta"
if [ ! -f "$KEYOUT" ]; then

	# Map the Hap2 onto Hap1 to place scaffolds
	echo "[$(date)] mapping Hap2 onto size-sorted Hap1 with minimap2..."
	$MINIMAP2 --cs -N 100 -p 0.0001 -x asm20 -t $THREADS $NEWBASE.chromsort.tweak.fasta $HAP2 > tmp$HAPBASE2.paf && mv -v tmp$HAPBASE2.paf $HAPBASE2.paf
	echo "[$(date)] assigning Hap2 scaffolds to Hap1 scaffolds, reorienting and renaming with PAFScaff	..."
	python3 $SLIMSUITE/tools/pafscaff.py -pafin $HAPBASE2.paf -seqin $HAP2 -reference $NEWBASE.chromsort.tweak.fasta -basefile $HAPBASE2 -refprefix $PREF1 -newprefix $PREF2 -unplaced ${PREF2}SCF -ctgprefix ${PREF2}CTG -threads $THREADS scaffold=F purechrom=T i=-1 v=0 log=$LOG
	cat $HAPBASE2.placed.fasta $HAPBASE2.unplaced.fasta > $HAPBASE2.sorted.fasta
	# Map the Hap1 onto Hap2 to pick up any unplaced scaffolds
	echo "[$(date)] re-mapping original Hap1 onto sorted Hap2 with minimap2 to pick up unplaced scaffolds..."
	$MINIMAP2 --cs -N 100 -p 0.0001 -x asm20 -t $THREADS $HAPBASE2.sorted.fasta $NEWBASE.chromsort.tweak.fasta > tmp$HAPBASE1.paf && mv -v tmp$HAPBASE1.paf $HAPBASE1.paf
	echo "[$(date)] assigning Hap1 scaffolds to Hap2 scaffolds, reorienting and renaming with PAFScaff..."
	python3 $SLIMSUITE/tools/pafscaff.py -pafin $HAPBASE1.paf -seqin $NEWBASE.chromsort.tweak.fasta -reference $HAPBASE2.sorted.fasta -basefile $HAPBASE1 -refprefix $PREF2 -newprefix $PREF1 -unplaced ${PREF1}SCF -ctgprefix ${PREF1}CTG -threads $THREADS scaffold=F purechrom=T i=-1 v=0 log=$LOG
	cat $HAPBASE1.placed.fasta $HAPBASE1.unplaced.fasta > $HAPBASE1.sorted.fasta
	# Summarise
	echo "[$(date)] summarising sorted and renamed haplotypes..."
	python3 $SLIMSUITE/tools/seqsuite.py summarise batchrun="$HAPBASE1.sorted.fasta,$HAPBASE2.sorted.fasta" dna basefile=$NEWBASE i=-1 v=0 log=$LOG \
		&& sed -i 's/.fasta//' $NEWBASE.summarise.tdt \
		&& column -t $NEWBASE.summarise.tdt \
		&& echo -e "$START\n[$(date)] Step $STEP complete" | tee $STEP.done

else
	echo "[$(date)] File found: $KEYOUT - skipping $STEP step" | tee -a $LOG
fi
# Check for key output files
for KEYOUT in $KEYOUTS; do
	if [ ! -f "$KEYOUT" ]; then
		echo "[$(date)] Failed to generate $KEYOUT" | tee -a $LOG
		exit 1
	fi
done
# Move unwanted files to intermediate directory
for EXT in paf placed.fasta unplaced.fasta placed.fasta.index unplaced.fasta.index; do
	$SHARPCLAW/exec/backupfile.exec $HAPBASE1.$EXT $STEP
	$SHARPCLAW/exec/backupfile.exec $HAPBASE2.$EXT $STEP
done
# Outputs:
# ├── $HAPBASE[12].scaffolds.tdt
# ├── $HAPBASE[12].sorted.fasta
# ├── $HAPBASE[12].sorted.fasta.index
# ├── $NEWBASE.sharpclaw.summarise.tdt
if [ "$RUNMODE" = "$STEP" ]; then
	echo "[$(date)] RUNMODE=$RUNMODE -> Exiting run." | tee -a $LOG
	exit 0;
fi


### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
### ~~~~ STEP 3: Telociraptor tweak of each haplotype and combine to make a diploid for the dual curation.. ~~~~ ###
## Goal: Combine and sort the haplotypes for dual curation in PreText of chromosome pairs.
## Rationale: Using Telociraptor for this can optionally fix telomeres and provide easy intervention and editing if needed.
## Method: Telociraptor is first used to make assembly maps that can be combined into a sorted diploid.
##		NOTE: By default, SharpClaw will trim or invert contigs within 5% of the scaffold ends to reveal telomeres.
##		Update the TRIMLIMIT and INVLIMIT settings in the config file to alter. (Set to 0 to disable.)
## Key inputs: Sorted Hap1 and Hap2 assemblies.
## Key outputs: Combined sorted diploid assembly
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
STEP=03-Diploid
START="[$(date)] Step $STEP"
KEYOUT=$NEWBASE.dip.fasta
if [ ! -f "$KEYOUT" ]; then

	# Optionally tweak the haplotypes and generate associated files
	echo "[$(date)] Optionally tweak the haplotypes and generate assembly maps..."
	python3 $SLIMSUITE/tools/telociraptor.py -seqin $HAPBASE1.sorted.fasta -basefile $HAPBASE1.sorted invlimit=$INVLIMIT trimlimit=$TRIMLIMIT i=-1 v=0 log=$LOG
	python3 $SLIMSUITE/tools/telociraptor.py -seqin $HAPBASE2.sorted.fasta -basefile $HAPBASE2.sorted invlimit=$INVLIMIT trimlimit=$TRIMLIMIT i=-1 v=0 log=$LOG
	echo "[$(date)] Renaming $HAPBASE1.sorted.tweak.* and $HAPBASE2.sorted.tweak.* to $NEWBASE.hap[12].* ..."	
	for EXT in txt fasta fasta.index gaps.TDT gaplen.tdt contigs.tdt telomeres.tdt; do
		mv -v $HAPBASE1.sorted.tweak.$EXT $NEWBASE.hap1.$EXT
		mv -v $HAPBASE2.sorted.tweak.$EXT $NEWBASE.hap2.$EXT
	done
	echo "NOTE: if editing the $NEWBASE.hap*.txt maps, regenerate from the $HAPBASE1.sorted.fasta and $HAPBASE2.sorted.fasta files"
	# Checking files generate OK
	for KEYOUT in $NEWBASE.hap1.fasta $NEWBASE.hap2.fasta $NEWBASE.hap1.txt $NEWBASE.hap2.txt; do
		if [ ! -f "$KEYOUT" ]; then
			echo "[$(date)] Failed to generate $KEYOUT" | tee -a $LOG
			exit 1
		fi
	done
	# Diploid assembly generation
	echo "[$(date)] Combine haplotypes into diploid assembly..."
	MAP=$NEWBASE.dip.txt
	for CHR in $(cat $NEWBASE.hap[12].fasta.index | sed "s/${PREF1}CHR/CHR/" | sed "s/${PREF2}CHR/CHR/" | sed "s/\./ /" | grep ^CHR | awk '{print $1;}' | sort -u); do
	  	grep ^\|\|$PREF1$CHR $NEWBASE.hap1.txt | tee -a $MAP
	  	grep ^\|\|$PREF2$CHR $NEWBASE.hap2.txt | tee -a $MAP
	done
	cat $NEWBASE.hap1.txt | grep -v ^\|\|${PREF1}CHR | tee -a $MAP
	cat $NEWBASE.hap2.txt | grep -v ^\|\|${PREF2}CHR | tee -a $MAP
	echo "[$(date)] Generating unsorted diploid assembly..."
	cat $HAPBASE1.sorted.fasta $HAPBASE2.sorted.fasta > $NEWBASE.unsorted.dip.fasta
	echo "[$(date)] Telociraptor reorganisation of diploid into paired chromosomes..."
	python3 $SLIMSUITE/tools/telociraptor.py -seqin $NEWBASE.unsorted.dip.fasta -mapin $MAP -seqout $NEWBASE.dip.fasta -basefile $NEWBASE.dip i=-1 v=0 log=$LOG \
		&& echo -e "$START\n[$(date)] Step $STEP complete" | tee $STEP.done

else
	echo "[$(date)] File found: $KEYOUT - skipping $STEP step" | tee -a $LOG
fi
# Check for key output file
if [ ! -f "$KEYOUT" ]; then
	echo "[$(date)] Failed to generate $KEYOUT" | tee -a $LOG
	exit 1
fi
# Move unwanted files to intermediate directory
for EXT in gaplen.tdt gaps.tdt contigs.tdt contigs.telomeres.tdt ctgmap.txt; do
	$SHARPCLAW/exec/backupfile.exec $HAPBASE1.sorted.$EXT $STEP
	$SHARPCLAW/exec/backupfile.exec $HAPBASE2.sorted.$EXT $STEP
done
# Outputs:
# ├── $NEWBASE.hap[12].txt
# ├── $NEWBASE.hap[12].fasta
# ├── $NEWBASE.hap[12].fasta.index
# ├── $NEWBASE.hap[12].gaplen.tdt
# ├── $NEWBASE.hap[12].gaps.tdt
# ├── $NEWBASE.hap[12].contigs.tdt
# ├── $NEWBASE.hap[12].telomeres.tdt
# ├── $NEWBASE.dip.txt
# ├── $NEWBASE.dip.fasta
# ├── $NEWBASE.dip.tweak.txt
# $DEV=TRUE only:
# ├── $NEWBASE.unsorted.dip.fasta
# ├── $NEWBASE.unsorted.dip.fasta.index
if [ ! $DEV == "TRUE" ]; then
	$SHARPCLAW/exec/backupfile.exec $NEWBASE.unsorted.dip.fasta $STEP
	$SHARPCLAW/exec/backupfile.exec $NEWBASE.unsorted.dip.fasta.index $STEP
fi
if [ "$RUNMODE" = "$STEP" ]; then
	echo "[$(date)] RUNMODE=$RUNMODE -> Exiting run." | tee -a $LOG
	exit 0;
fi


### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
### ~~~~ STEP 4: Launch Pairtools and PreText in the background ~~~~ ###
## Goal: Generate the contact maps for Dual curation of chromosomes.
## Rationale: Aligns with general VGP/DToL strategy.
## Method: Omni-C pipeline using pairtools to map HiC reads to genome then PreText and PreTextSnapshot.
## Key inputs: Sorted diploid assembly.
## Key outputs: HiC-mapped BAM file, PreText contact map and PreTextSnapshort images.
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
STEP=04-PreText
START="[$(date)] Step $STEP"
KEYOUT=$NEWBASE.dip.mapped.PT.bam
if [ ! -f "$KEYOUT" ]; then

	# Define key new variables
	NCPU=48; MEM=84
	GENOME=$NEWBASE.dip.fasta
	
	# Execute code for step
	if [ ! $QUEUEJOBS = "FALSE" ]; then
		echo "[$(date)] Queueing up Pairtools and PreText to run in the background..."
		#i# This will now run in the background. Can look for the finished version later if needed.
		JOB=pt$(basename ${GENOME/.fasta/})
		cat $SCRIPTDIR/jobhead.sh | sed "s/cpus-per-task=16/cpus-per-task=$NCPU/" | sed "s/mem=28G/mem=${MEM}G/" | sed "s/job-name=sharpclaw/job-name=$JOB/" | tee $JOB.sh
		echo "$SETUPENV" | tee -a $JOB.sh
		echo "GENOME=$GENOME" | tee -a $JOB.sh
		echo HIC1=$HIC1 | tee -a $JOB.sh
		echo HIC2=$HIC2 | tee -a $JOB.sh
		echo ls -lrth $GENOME $HIC1 $HIC2 | tee -a $JOB.sh
		echo "[$(date)] Executing Pairtools workflow..." | tee -a $JOB.sh
		cat $EXECDIR/dualpairtools.exec | tee -a $JOB.sh
		echo "[$(date)] Executing PreText workflow..." | tee -a $JOB.sh
		cat $EXECDIR/pretext.exec | tee -a $JOB.sh
		echo "echo $START | tee $RUNDIR/$STEP.done" | tee -a $JOB.sh
		echo "echo \"[\$(date)] Step $STEP complete\" | tee -a $RUNDIR/$STEP.done" | tee -a $JOB.sh
		cat $SCRIPTDIR/jobtail.sh | tee -a $JOB.sh && $RUNCMD $JOB.sh
	else
		echo "[$(date)] Executing Pairtools workflow..."
		source $EXECDIR/dualpairtools.exec
		echo "[$(date)] Executing PreText workflow..."
		source $EXECDIR/pretext.exec \
			&& echo -e "$START\n[$(date)] Step $STEP complete" | tee $STEP.done
	fi		

else
	echo "[$(date)] File found: $KEYOUT - skipping $STEP step" | tee -a $LOG
fi
# NOTE: PreText files are cleaned up in the pretext.exec script
# Outputs:
# ├── $NEWBASE.dip.stats.txt
# ├── $NEWBASE.dip.mapped.PT.bam
# ├── $NEWBASE.dip.mapped.PT.bam.bai
# ├── $NEWBASE.dip.map.pretext
# ├── $NEWBASE.dip.snapshot.tar.gz
if [ "$RUNMODE" = "$STEP" ]; then
	echo "[$(date)] RUNMODE=$RUNMODE -> Exiting run." | tee -a $LOG
	exit 0;
fi

### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
### ~~~~ STEP 4b: Launch unsorted Pairtools and PreText in the background (DEV mode) ~~~~ ###
## Goal: Generate the contact maps for without sorting to illustrate the utility of SharClaw.
## Rationale: Aligns with general VGP/DToL strategy.
## Method: Omni-C pipeline using pairtools to map HiC reads to genome then PreText and PreTextSnapshot.
## Key inputs: Unsorted diploid assembly.
## Key outputs: HiC-mapped BAM file, PreText contact map and PreTextSnapshort images.
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
STEP=04b-UnsortedPreText
START="[$(date)] Step $STEP"
KEYOUT=$NEWBASE.unsorted.dip.mapped.PT.bam
if [ ! -f "$KEYOUT" ] && [ "$DEV" = "TRUE" ]; then

	# Define key new variables
	NCPU=48; MEM=84
	GENOME=$NEWBASE.unsorted.dip.fasta
	
	# Execute code for step
	if [ ! $QUEUEJOBS = "FALSE" ]; then
		JOB=pt$(basename ${GENOME/.fasta/})
		cat $SCRIPTDIR/jobhead.sh | sed "s/cpus-per-task=16/cpus-per-task=$NCPU/" | sed "s/mem=28G/mem=${MEM}G/" | sed "s/job-name=sharpclaw/job-name=$JOB/" | tee $JOB.sh
		echo "$SETUPENV" | tee -a $JOB.sh
		echo "GENOME=$GENOME" | tee -a $JOB.sh
		echo HIC1=$HIC1 | tee -a $JOB.sh
		echo HIC2=$HIC2 | tee -a $JOB.sh
		echo ls -lrth $GENOME $HIC1 $HIC2 | tee -a $JOB.sh
		cat $EXECDIR/dualpairtools.exec | tee -a $JOB.sh
		cat $EXECDIR/pretext.exec | tee -a $JOB.sh
		echo touch $STEP.done | tee -a $JOB.sh
		cat $SCRIPTDIR/jobtail.sh | tee -a $JOB.sh && $RUNCMD $JOB.sh
	else
		source $EXECDIR/dualpairtools.exec && source $EXECDIR/pretext.exec | tee -a $JOB.sh \
			&& echo -e "$START\n[$(date)] Step $STEP complete" | tee $STEP.done
	fi		

else
	if [ "$DEV" = "TRUE" ]; then
		echo "[$(date)] File found: $KEYOUT - skipping $STEP step" | tee -a $LOG
	else
		echo "[$(date)] DEV=FALSE - skipping $STEP step" | tee -a $LOG
	fi
fi
# NOTE: PreText files are cleaned up in the pretext.exec script
# Outputs:
# ├── $NEWBASE.unsorted.dip.stats.txt
# ├── $NEWBASE.unsorted.dip.mapped.PT.bam
# ├── $NEWBASE.unsorted.dip.mapped.PT.bam.bai
# ├── $NEWBASE.unsorted.dip.map.pretext
# ├── $NEWBASE.unsorted.dip.snapshot.tar.gz


### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
### ~~~~ STEP 5: Run Compleasm on two haplotypes and combine into diploid. ~~~~ ###
## Goal: Generate BUSCO complete genes for Basic synteny plots and SC depth estimates.
## Rationale: BUSCO synteny is an efficient mechanism for high-level synteny analysis.
## Method:  Compleasm genome mode run on each haplotype. Haploid tables are then combined into
##			a diploid assembly for use with Diploidocus etc.
## Key inputs: Haploid genome assemblies and ODB10 BUSCO dataset
## Key outputs: BUSCO-formate full tables of BUSCO gene predictions for each haplotype
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
STEP=05-Compleasm
START="[$(date)] Step $STEP"
KEYOUT=$NEWBASE.dip.$ODB10.full_table.tsv
KEYOUTS="$NEWBASE.hap1.$ODB10.full_table.tsv $NEWBASE.hap2.$ODB10.full_table.tsv"
if [ ! -f "$KEYOUT" ]; then

	# Execute code for step
	for GENOME in $NEWBASE.hap[12].fasta; do
		GENBASE=$(basename ${GENOME%.*})
		#---------------
		# Run Compleasm
		RUN=run_$GENBASE.compleasm
		THREADS=$SLURM_CPUS_PER_TASK
		echo "[$(date)] Running Compleasm ($ODB10) on $GENOME..."
		$COMPLEASM run -a $GENOME -o $RUN -t $THREADS -l ${ODB10/_odb10/} -L $LPATH
		#---------------
		# Tidy Compleasm 
		echo "[$(date)] Cleanup $ODB10 Compleasm run $RUN"
		CBASE=$GENBASE.$ODB10
		cp -v $RUN/summary.txt $CBASE.compleasm.txt
		cp -v $RUN/$ODB10/full_table.tsv $CBASE.compleasm.tsv
		cp -v $RUN/$ODB10/full_table_busco_format.tsv $CBASE.full_table.tsv
		tar -c $RUN | pigz > $RUN.tar.gz && rm -rf $RUN
	done
	# Combine outputs for Diploid
	echo "[$(date)] Combing haploid $ODB10 Compleasm runs"
	cp $NEWBASE.hap1.$ODB10.full_table.tsv $KEYOUT \
		&& grep $PREF2 $NEWBASE.hap2.$ODB10.full_table.tsv >> $KEYOUT \
		&& echo -e "$START\n[$(date)] Step $STEP complete" | tee $STEP.done

else
	echo "[$(date)] File found: $KEYOUT - skipping $STEP step" | tee -a $LOG
fi
# Check for key output files
for KEYOUT in $KEYOUTS; do
	if [ ! -f "$KEYOUT" ]; then
		echo "[$(date)] Failed to generate $KEYOUT" | tee -a $LOG
		exit 1
	fi
done
# Move unwanted files to intermediate directory
for HAP in hap1 hap2; do
	for EXT in $ODB10.compleasm.txt $ODB10.compleasm.tsv; do
		$SHARPCLAW/exec/backupfile.exec $NEWBASE.$HAP.$EXT $STEP
	done
	$SHARPCLAW/exec/backupfile.exec run_$NEWBASE.$HAP.compleasm.tar.gz $STEP
done
# Outputs:
# ├── $NEWBASE.hap[12].$ODB10.full_table.tsv
# ├── $NEWBASE.dip.$ODB10.full_table.tsv
if [ "$RUNMODE" = "$STEP" ]; then
	echo "[$(date)] RUNMODE=$RUNMODE -> Exiting run." | tee -a $LOG
	exit 0;
fi


### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
### ~~~~ STEP 6: barrnap rRNA predictions for ChromSyn plots and rRNA contigs   ~~~~ ###
## Goal: Identify rRNA repeats
## Rationale: rRNA repeats frequently cause assembly breakdown and/or extra contigs
## Method: Run Barrnap of each haplotype
## Key inputs: Sorted haplotype assemblies
## Key outputs: rRNA prediction CSV files for each haplotype
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
STEP=06-Barrnap
START="[$(date)] Step $STEP"
KEYOUT=$NEWBASE.hap2.rrna.csv
KEYOUTS="$NEWBASE.hap1.rrna.csv $NEWBASE.hap2.rrna.csv"
if [ ! -f "$KEYOUT" ]; then

	# Execute code for step
	mkdir $RUNDIR/$STEP; cd $RUNDIR/$STEP
	# Run barrnap (rDNA)
	for GENOME in ../$NEWBASE.hap[12].fasta; do
	  	GENBASE=$(basename ${GENOME/.fasta/})
		echo "[$(date)] Running Barrnap to find rDNA in $GENBASE..."
		if [ ! -f "$GENBASE.full.ctg.txt" ]; then
			sed 's/^[ACGT][ACGT][ACGT][ACGT]/GATC/' $GENOME > $GENBASE.tmp.fasta
			$BARRNAP --kingdom euk -o $GENBASE.rrna.fa --threads $THREADS < $GENBASE.tmp.fasta | tee $GENBASE.rrna.gff
			rm -v $GENBASE.tmp.fasta
			#i# Make a GFF for plotting with ChromSyn and analysis with DepthKopy
			grep -v 5S $GENBASE.rrna.gff | grep -v partial | tee $GENBASE.rdna.gff
			#i# Find full-length rDNA repeats
			touch $GENBASE.full.ctg.txt
			for S in 5.8 18 28; do
			  echo $GENBASE ${S}S "=>" $(grep "${S}S" $GENBASE.rrna.gff | grep -v partial | awk '{print $1;}' | sort | uniq -c ) | tee -a $GENBASE.rrna.full.ctg.txt
			done
			#i# Make a feature file for ChromSyn
			echo SeqName,Start,End,Strand,Col,Shape | tee $GENBASE.rrna.csv
			grep RNA $GENBASE.rrna.gff | grep -v partial | sed 's/=/ /g' | awk '{print $1,$4,$5,$7,$11;}' | sed "s/ /,/g" | sed 's/5S/"white",23/' | sed 's/5.8S/"pink",22/' | sed 's/18S/"skyblue",24/' | sed 's/28S/"seagreen",25/' | tee -a $GENBASE.rrna.csv
		fi
	done
	for KEYOUT in $KEYOUTS; do
		cp -v $KEYOUT $RUNDIR/.
	done && echo -e "$START\n[$(date)] Step $STEP complete" | tee $RUNDIR/$STEP.done
	cd $RUNDIR
	
else
	echo "[$(date)] File found: $KEYOUT - skipping $STEP step" | tee -a $LOG
fi
# Check for key output files
for KEYOUT in $KEYOUTS; do
	if [ ! -f "$KEYOUT" ]; then
		echo "[$(date)] Failed to generate $KEYOUT" | tee -a $LOG
		exit 1
	fi
done
# Outputs:
# ├── $NEWBASE.hap[12].rrna.csv
if [ "$RUNMODE" = "$STEP" ]; then
	echo "[$(date)] RUNMODE=$RUNMODE -> Exiting run." | tee -a $LOG
	exit 0;
fi

### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
### ~~~~ STEP 7: Simple ChromSyn Compleasm synteny plot. ~~~~ ###
## Goal: Generate a basic synteny plot based on BUSCO genes
## Rationale: Coarse synteny plots can identify inversions and chromosomes fusions/translocations
## Method: Generate TIDK telomere predictions and run run ChromSyn on haplotypes
## Key inputs: Haplotype assemblies, Telociraptor telomeres tables, Compleasm BUSCO tables, rRNA CSV files
## Key outputs: Basic synteny plot of the two sorted haplotypes
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
STEP=07-SimpleChromSyn
START="[$(date)] Step $STEP"
KEYOUT=$NEWBASE.hapcheck.pdf
if [ ! -f "$KEYOUT" ]; then
	# Setup run directory
	mkdir $RUNDIR/$STEP; cd $RUNDIR/$STEP
	# Generate TIDK telomere tables
    echo "[$(date)] Running TIDK on Haplotypes..."
	for GENOME in ../$NEWBASE.hap[12].fasta; do
		GENBASE=$(basename ${GENOME/.fasta/})
		$TIDK search -o $GENBASE -s AACCCT -d ./ -e tsv $GENOME
		awk '$3 > 9 || $4 > 9' ${GENBASE}_telomeric_repeat_windows.tsv > ../$GENBASE.tidk.tsv
	done
	# Generate the FOFN files from a template:
    echo "[$(date)] Generating FOFN files..."
	echo $PREF1 ../$NEWBASE.hap1 | tee template.fofn
	echo $PREF2 ../$NEWBASE.hap2 | tee -a template.fofn
	for FOFNDATA in telomeres.tdt-sequences $ODB10.full_table.tsv-busco gaps.tdt-gaps tidk.tsv-tidk rrna.csv-ft; do
		EXT=$(echo $FOFNDATA | awk -F '-' '{print $1;}')
		FOFN=$(echo $FOFNDATA | awk -F '-' '{print $2;}').fofn
		sed "s/$/.$EXT/" template.fofn | tee $FOFN
	done
	# Run ChromSyn
	echo "[$(date)] Running Basic ChromSyn on Haplotypes..."
	FOCUS=$PREF1
	SETTINGS="pdfwidth=40 orphans=FALSE minregion=0 minbusco=1 ticks=1e7"
	RUN=$NEWBASE
	BASE=hapcheck
	$RSCRIPT $SLIMSUITE/libraries/r/chromsyn.R $SETTINGS focus=$FOCUS basefile=$RUN.$BASE ybleed=1 | tee $RUN.$BASE.log \
		&& cp -v $KEYOUT $RUNDIR/. \
		&& echo -e "$START\n[$(date)] Step $STEP complete" | tee $RUNDIR/$STEP.done
	cd $RUNDIR

else
	echo "[$(date)] File found: $KEYOUT - skipping $STEP step" | tee -a $LOG
fi
# Check for key output file
if [ ! -f "$KEYOUT" ]; then
	echo "[$(date)] Failed to generate $KEYOUT" | tee -a $LOG
fi
# Outputs:
# ├── $NEWBASE.hapcheck.pdf
if [ "$RUNMODE" = "$STEP" ] || [ "$RUNMODE" = "BASIC" ]; then
	echo "[$(date)] RUNMODE=$RUNMODE -> Exiting run." | tee -a $LOG
	exit 0;
fi


### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
### ~~~~ STEP 8: Diploid Read Mapping for DepthKopy, DepthCharge and Diploidocus. ~~ ###
## Goal: Generate haploid BAM and PAF files of mapped reads using Diploid read mapping.
## Rationale: Mapping to the combined diploid should improve resolution of haplotype-specific sequences
## Method: Map long reads to diploid, partition into haploids and convert to PAF.
## Key inputs: Combined diploid assembly and raw long reads
## Key outputs: BAM and PAF files for each haplotype of mapped long reads
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
STEP=08-ReadMapping
START="[$(date)] Step $STEP"
KEYOUT=$NEWBASE.hap2.$READTYPE.paf
KEYOUTS="$NEWBASE.hap1.$READTYPE.bam $NEWBASE.hap2.$READTYPE.bam $NEWBASE.hap1.$READTYPE.paf $KEYOUT"
if [ ! -f "$KEYOUT" ]; then

	# Define key new variables inc. settings for Minimap2
	MMSETTINGS="-I 4G -L --secondary=no"
	SAM=$NEWBASE.dip.$READTYPE.sam
	BAM=${SAM/.sam/.bam}
	
	# Execute code for step
	echo "[$(date)] Generating diploid BAM and PAF files..."
	$MINIMAP2 -t $THREADS $MMSETTINGS -o $SAM -ax map-$READTYPE $NEWBASE.dip.fasta $READS \
		&& $SAMTOOLS view -bo ${SAM/.sam/.tmp.bam} --threads $THREADS -S $SAM \
		&& $SAMTOOLS sort --threads $THREADS -o $BAM ${SAM/.sam/.tmp.bam} \
		&& $PAFTOOLS sam2paf -L $SAM > ${SAM/.sam/.paf} \
		&& $SAMTOOLS index -b $BAM $BAM.bai \
		&& rm -v ${SAM/.sam/.tmp.bam} $SAM 
	echo "[$(date)] Splitting BAM and PAF files into haplotypes..."
	HAPBASE=$NEWBASE.hap1
	awk '{print $1"\t1\t"$2;}' $HAPBASE.telomeres.tdt | grep -v SeqName | tee $HAPBASE.bed \
		&& $SAMTOOLS view -h -@ $THREADS -L $HAPBASE.bed $BAM | grep -v "SN:$PREF2" | $SAMTOOLS view -hb -@ $THREADS - > $HAPBASE.$READTYPE.bam \
		&& $SAMTOOLS index -b $HAPBASE.$READTYPE.bam $HAPBASE.$READTYPE.bam.bai
	grep $PREF1 ${SAM/.sam/.paf} > $HAPBASE.$READTYPE.paf
	HAPBASE=$NEWBASE.hap2
	awk '{print $1"\t1\t"$2;}' $HAPBASE.telomeres.tdt | grep -v SeqName | tee $HAPBASE.bed \
		&& $SAMTOOLS view -h -@ $THREADS -L $HAPBASE.bed $BAM | grep -v "SN:$PREF1" | $SAMTOOLS view -hb -@ $THREADS - > $HAPBASE.$READTYPE.bam \
		&& $SAMTOOLS index -b $HAPBASE.$READTYPE.bam $HAPBASE.$READTYPE.bam.bai
	grep $PREF2 ${SAM/.sam/.paf} > $HAPBASE.$READTYPE.paf
	echo -e "$START\n[$(date)] Step $STEP complete" | tee $STEP.done

else
	echo "[$(date)] File found: $KEYOUT - skipping $STEP step" | tee -a $LOG
fi
# Check for key output files
for KEYOUT in $KEYOUTS; do
	if [ ! -f "$KEYOUT" ]; then
		echo "[$(date)] Failed to generate $KEYOUT" | tee -a $LOG
		exit 1
	fi
done
# Move unwanted files to intermediate directory
for EXT in hifi.bam hifi.bam.bai hifi.paf; do
	$SHARPCLAW/exec/backupfile.exec $NEWBASE.dip.$EXT $STEP
done
# Outputs:
# ├── $NEWBASE.hap[12].bed
# ├── $NEWBASE.hap[12].hifi.bam
# ├── $NEWBASE.hap[12].hifi.bam.bai
# ├── $NEWBASE.hap[12].hifi.paf
if [ "$RUNMODE" = "$STEP" ]; then
	echo "[$(date)] RUNMODE=$RUNMODE -> Exiting run." | tee -a $LOG
	exit 0;
fi

### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
### ~~~~ STEP 9: DepthCharge identification of coverage dropout. ~~~~ ###
## Goal: Identify locations of no read coverage.
## Rationale: Misassemblies will not have reads mapping across them.
## Method: Run DepthCharge, which identifies regions where read coverage disappears.
## Key inputs: Haploid assemblies and PAF files of $READTYPE reads mapped
## Key outputs: DepthCharge delimited tables with locations needing attention. 
###             Gaps and contigs files are used for SynBad.
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
STEP=09-DepthCharge
START="[$(date)] Step $STEP"
KEYOUT=$NEWBASE.hap2.depthcharge.tdt
KEYOUTS="$KEYOUT"
if [ ! -f "$KEYOUT" ]; then

	# No new variables to define
	# Execute code for step
	for HAP in hap1 hap2; do
		GENBASE=$NEWBASE.$HAP
		$DEPTHCHARGE -seqin $GENBASE.fasta -basefile $GENBASE -threads $THREADS -paf $GENBASE.$READTYPE.paf -minspan 10 -breakmode report i=-1 v=0
	done
	echo -e "$START\n[$(date)] Step $STEP complete" | tee $STEP.done

else
	echo "[$(date)] File found: $KEYOUT - skipping $STEP step" | tee -a $LOG
fi
# Check for key output files
for KEYOUT in $KEYOUTS; do
	if [ ! -f "$KEYOUT" ]; then
		echo "[$(date)] Failed to generate $KEYOUT" | tee -a $LOG
		exit 1
	fi
done
# Move unwanted files to intermediate directory
for EXT in gaplen.tdt log; do
	$SHARPCLAW/exec/backupfile.exec $NEWBASE.hap1.$EXT $STEP
	$SHARPCLAW/exec/backupfile.exec $NEWBASE.hap2.$EXT $STEP
done
# Outputs:
# ├── $NEWBASE.hap[12].contigs.tdt 
# ├── $NEWBASE.hap[12].depthcharge.tdt
# ├── $NEWBASE.hap[12].gaps.tdt 
if [ "$RUNMODE" = "$STEP" ]; then
	echo "[$(date)] RUNMODE=$RUNMODE -> Exiting run." | tee -a $LOG
	exit 0;
fi


### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
### ~~~~ STEP 10: KAT and selfhom file generation for DepthKopy and Diploidocus ~~~~ ###
## Goal: Generate kmer reads and assembly kmer counts, and self-homology file for uniqueness. 
## Rationale: Kmers can provide complementary evidence (to depth) of regions collapsed or duplicated.
##            The self-mapping is to help distinguish unique regions from duplicates (real and false).
## Method: Run KAT on each haplotype using all kmer reads and each haplotype to provide kmers.
##         Use minimap2 for rapid homology within one haplotype.
## Key inputs: Haplotype assemblies. Kmer (high accuracy) reads.
## Key outputs: Kmer stats and count files. Self-mapping BAM file.
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
STEP=10-KAT
START="[$(date)] Step $STEP"
KEYOUT=$NEWBASE.hap2.self.bam
KEYOUTS="$NEWBASE.hap1.self.bam $NEWBASE.hap2.self.bam"
if [ ! -f "$KEYOUT" ]; then

	# No new variables to define
	# Execute code for step
	#i# Create *.kat-stats.tsv and *.kat-counts.cvg
	for HAP in hap1 hap2; do
		if [ ! -f "$NEWBASE.$HAP.self.bam" ]; then
			#a# $KMERREADS
			if [ "$TRIM10X" = "T" ]; then
				$KAT sect -t $THREADS --5ptrim 16,0 -o $NEWBASE.$HAP.kat $NEWBASE.$HAP.fasta ${KMERREADS/,/ }
			else
				$KAT sect -t $THREADS -o $NEWBASE.$HAP.kat $NEWBASE.$HAP.fasta ${KMERREADS/,/ }	
			fi
			#b# Self
			$KAT sect -t $THREADS -o $NEWBASE.$HAP.selfkat $NEWBASE.$HAP.fasta $NEWBASE.$HAP.fasta
			#c# Alt
			ALTGENOME=$NEWBASE.hap1.fasta
			if [ "$HAP" == "hap1" ]; then
				ALTGENOME=$NEWBASE.hap2.fasta
			fi
			$KAT sect -t $THREADS -o $NEWBASE.$HAP.alt.kat $NEWBASE.$HAP.fasta $ALTGENOME
			#i# Create self homology file
			MMSETTINGS="-aDP -I 4G -k19 -w19 -m200"
			$MINIMAP2 -t $THREADS $MMSETTINGS $NEWBASE.$HAP.fasta $NEWBASE.$HAP.fasta | \
				$SAMTOOLS view -b -h - | \
				$SAMTOOLS sort - | tee $NEWBASE.$HAP.self.bam | \
				$SAMTOOLS flagstat - 
			$SAMTOOLS index -b $NEWBASE.$HAP.self.bam $NEWBASE.$HAP.self.bam.bai
		fi
	done

	echo -e "$START\n[$(date)] Step $STEP complete" | tee $STEP.done

else
	echo "[$(date)] File found: $KEYOUT - skipping $STEP step" | tee -a $LOG
fi
# Check for key output files
for KEYOUT in $KEYOUTS; do
	if [ ! -f "$KEYOUT" ]; then
		echo "[$(date)] Failed to generate $KEYOUT" | tee -a $LOG
		exit 1
	fi
done
# No unwanted files to move to intermediate directory
# Outputs:
# ├── $NEWBASE.hap[12].kat-counts.cvg
# ├── $NEWBASE.hap[12].kat-stats.tsv
# ├── $NEWBASE.hap[12].gaps.tdt 
# ├── $NEWBASE.hap[12].selfkat-counts.cvg
# ├── $NEWBASE.hap[12].selfkat-stats.tsv
# ├── $NEWBASE.hap[12].alt.kat-counts.cvg
# ├── $NEWBASE.hap[12].alt.kat-stats.tsv
# ├── $NEWBASE.hap[12].self.bam
# ├── $NEWBASE.hap[12].self.bam.bai
if [ "$RUNMODE" = "$STEP" ]; then
	echo "[$(date)] RUNMODE=$RUNMODE -> Exiting run." | tee -a $LOG
	exit 0;
fi


### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
### ~~~~ STEP 11: DepthKopy CN estimation for ChromSyn plots.                   ~~~~ ###
## Goal: Generate DepthKopy copy number (CN) estimates for the ChromSyn plots.
## Rationale: Aggregated CN estimates across genes/contigs/regions can highlight collapsed or duplicated regions.
## Method: Run DepthKopy using the inputs generated by the earlier steps.
## Key inputs: haplotype assemblies, mapped reads, BUSCO results, KAT outputs, contig tables.
## Key outputs: full table TSV and compiled Excel. CN distribution plots.
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
STEP=11-DepthKopy
START="[$(date)] Step $STEP"
KEYOUT=$NEWBASE.hap2.fulltable.tsv
KEYOUTS="$NEWBASE.hap1.fulltable.tsv $KEYOUT"
if [ "$DEPTHKOPYCN" = "TRUE" ] && [ ! -f "$KEYOUT" ]; then

	# Define key new variables
	#i# NOTE: DepthKopy can run out of memory with 32 threads and 56G memory. 
	#i# Reducing the thread count here. Might need to set as a new config setting.
	#i# It will try re-running without the KAT data if fails to complete.
	echo "Running DepthKopy with $DKFORKS threads..."
	# Execute code for step
	#i# Run DepthKopy
	for HAP in hap1 hap2; do
		if [ ! -f "$NEWBASE.$HAP.fulltable.tsv" ]; then
			GENBASE=$NEWBASE.$HAP
			BUSCO=$GENBASE.$ODB10.full_table.tsv
			BAM=$GENBASE.$READTYPE.bam
			CONTIGS=$GENBASE.contigs.tdt
			ALTGENOME=$NEWBASE.hap1.fasta
			if [ "$HAP" == "hap1" ]; then
				ALTGENOME=$NEWBASE.hap2.fasta
			fi
			# Try with CSI indexing if BAM.bai missing
			if [ ! -f "$BAM.bai" ]; then
				$DEPTHKOPY -threads $DKFORKS -seqin $GENBASE.fasta -basefile $GENBASE -busco $BUSCO -bam $BAM kmerreads="$KMERREADS" kmeralt=$ALTGENOME regfile=Contigs:$CONTIGS reghead=seqname,start,end i=-1 v=0 bamcsi=T
			else
				$DEPTHKOPY -threads $DKFORKS -seqin $GENBASE.fasta -basefile $GENBASE -busco $BUSCO -bam $BAM kmerreads="$KMERREADS" kmeralt=$ALTGENOME regfile=Contigs:$CONTIGS reghead=seqname,start,end i=-1 v=0
			fi
			# Try re-running without the KAT data if the run failed.
			if [ ! -f "$NEWBASE.$HAP.fulltable.csv" ]; then
				echo "DepthKopy run failed. Possible memory problems? Will try without KAT data. If problems remain, try increasing memory requested."
				if [ ! -f "$BAM.bai" ]; then
					$DEPTHKOPY -threads $DKFORKS -seqin $GENBASE.fasta -basefile $GENBASE -busco $BUSCO -bam $BAM kmerreads= katfile=F kmeralt=None kmerself=F homfile=F regfile=Contigs:$CONTIGS reghead=seqname,start,end i=-1 v=0 bamcsi=T
				else
					$DEPTHKOPY -threads $DKFORKS -seqin $GENBASE.fasta -basefile $GENBASE -busco $BUSCO -bam $BAM kmerreads= katfile=F kmeralt=None kmerself=F homfile=F regfile=Contigs:$CONTIGS reghead=seqname,start,end i=-1 v=0
				fi
			fi
			
		fi
	done
	echo -e "$START\n[$(date)] Step $STEP complete" | tee $STEP.done

else
	echo "[$(date)] File found: $KEYOUT - skipping $STEP step" | tee -a $LOG
fi
# Check for key output files
for KEYOUT in $KEYOUTS; do
	if [ ! -f "$KEYOUT" ]; then
		#echo "[$(date)] WARNING: Failed to generate $KEYOUT - some later stages may be affected" | tee -a $LOG
		echo "[$(date)] Failed to generate $KEYOUT" | tee -a $LOG
		exit 1
	fi
done
# Tidy up some of the output files
rmdir -v tmpdir
for HAP in hap1 hap2; do
	GENBASE=$NEWBASE.$HAP
	cp -v $GENBASE.plots/$GENBASE.CN.pdf .
	echo "[$(date)] Tarballing $GENBASE.plots/ directory..."
	tar -cv $GENBASE.plots | pigz > $GENBASE.plots.tar.gz && rm -vrf $GENBASE.plots/* && rmdir -v $GENBASE.plots
done
# Move unwanted files to intermediate directory
for EXT in sys.log busco.dupcnv.tsv  ; do
	$SHARPCLAW/exec/backupfile.exec $NEWBASE.hap1.$EXT $STEP
	$SHARPCLAW/exec/backupfile.exec $NEWBASE.hap2.$EXT $STEP
done
mv -v $NEWBASE.hap[12].*.regcnv.tsv $STEP/.
# Outputs:
# ├── $NEWBASE.hap[12].CN.pdf 
# ├── $NEWBASE.hap[12].xlsx
# ├── $NEWBASE.hap[12].fasthom
# ├── $NEWBASE.hap[12].fulltable.tsv
# ├── $NEWBASE.hap[12].$READTYPE.bam.fastmp
if [ "$RUNMODE" = "$STEP" ]; then
	echo "[$(date)] RUNMODE=$RUNMODE -> Exiting run." | tee -a $LOG
	exit 0;
fi


### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
### ~~~~ STEP 12: SynBad Gap classification.                                    ~~~~ ###
## Goal: Use spanning reads and synteny between the two haplotypes to assess scaffolding.
## Rationale: Bad scaffolding is more likely to disrupt synteny or read mapping that enhance it.
## Method: SynBad haplotype-v-haplotype synteny and read-based gap assessment.
## Key inputs: Haplotype assemblies, BAM files, mapped HiC data, BUSCO results, DepthKopy
## Key outputs: SynBad-rated gaps for both haplotypes.
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
STEP=12-SynBad
START="[$(date)] Step $STEP"
KEYOUT=$NEWBASE.hap2.synbadgaps.tsv
KEYOUTS="$NEWBASE.synbad.qry.gap.tdt $NEWBASE.synbad.hit.gap.tdt"
if [ ! -f "$KEYOUT" ]; then

	# Define key new variables
	BASE1=$NEWBASE.hap1
	BASE2=$NEWBASE.hap2
	ls -lrth $BASE1.fasta $BASE1.$READTYPE.bam $BASE1.$READTYPE.paf $BASE1.$ODB10.full_table.tsv $BASE1.mapped.PT.bam
	ls -lrth $BASE2.fasta $BASE2.$READTYPE.bam $BASE2.$READTYPE.paf $BASE2.$ODB10.full_table.tsv $BASE2.mapped.PT.bam
	# 
	# Run SynBad. Will switch of use of BAM for depths if DEPTHKOPYCN!=TRUE 
	if [ "$DEPTHKOPYCN" = "TRUE" ]; then
		$SYNBAD genome1=$BASE1.fasta bam1=$BASE1.$READTYPE.bam paf1=$BASE1.$READTYPE.paf hicbam1=$BASE1.mapped.PT.bam busco1=$BASE1.$ODB10.full_table.tsv genome2=$BASE2.fasta bam2=$BASE2.$READTYPE.bam paf2=$BASE2.$READTYPE.paf hicbam2=$BASE2.mapped.PT.bam busco2=$BASE2.$ODB10.full_table.tsv basefile=$NEWBASE.synbad chr1=$PREF1 chr2=$PREF2 correct=invert spannedflank=100 synreadspan=3 i=-1 v=0 threads=$THREADS
	else
		$SYNBAD genome1=$BASE1.fasta bam1=None paf1=$BASE1.$READTYPE.paf hicbam1=$BASE1.mapped.PT.bam busco1=$BASE1.$ODB10.full_table.tsv genome2=$BASE2.fasta bam2=None paf2=$BASE2.$READTYPE.paf hicbam2=$BASE2.mapped.PT.bam busco2=$BASE2.$ODB10.full_table.tsv basefile=$NEWBASE.synbad chr1=$PREF1 chr2=$PREF2 correct=invert spannedflank=100 synreadspan=3 i=-1 v=0 threads=$THREADS
	fi

	echo -e "$START\n[$(date)] Step $STEP complete" | tee $STEP.done

	# Check for key output files
	for KEYOUT in $KEYOUTS; do
		if [ ! -f "$KEYOUT" ]; then
			echo "[$(date)] Failed to generate $KEYOUT" | tee -a $LOG
			exit 1
		fi
	done

else
	echo "[$(date)] File found: $KEYOUT - skipping $STEP step" | tee -a $LOG
fi

# Tidy up some of the output files
rmdir -v tmp/
for HAP in qry hit; do
	GENBASE=$NEWBASE.synbad.$HAP.flanks
	echo "[$(date)] Tarballing $GENBASE.plots/ directory..."
	tar -cv $GENBASE.plots | pigz > $GENBASE.plots.tar.gz && rm -v $GENBASE.plots/* && rmdir -v $GENBASE.plots
done
# Move unwanted files to intermediate directory
for EXT in .gap_pos.tdt .checkpos.tdt _spanid ; do
	$SHARPCLAW/exec/backupfile.exec $NEWBASE.hap1$EXT $STEP
	$SHARPCLAW/exec/backupfile.exec $NEWBASE.hap2$EXT $STEP
done
cp -v $NEWBASE.synbad.qry.gap.tdt $NEWBASE.hap1.synbadgaps.tsv
cp -v $NEWBASE.synbad.hit.gap.tdt $NEWBASE.hap2.synbadgaps.tsv
mv -v $NEWBASE.synbad.qry.* $STEP/.
mv -v $NEWBASE.synbad.hit.* $STEP/.
mv -v $NEWBASE.synbad.map.* $STEP/.
# Outputs:
# ├── $NEWBASE.synbad.hap[12].synbadgaps.tsv
# ├── $NEWBASE.synbad.summary.tdt
if [ "$RUNMODE" = "$STEP" ]; then
	echo "[$(date)] RUNMODE=$RUNMODE -> Exiting run." | tee -a $LOG
	exit 0;
fi


### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
### ~~~~ STEP 13: Detailed ChromSyn plots with DepthCharge, CN and SynBad       ~~~~ ###
## Goal: Plot synteny, depth details, gap ratings and possible assembly errors for assembly QC.
## Rationale: This plot can help identify regions requiring attention, or even guide direct editing.
## Method: ChromSyn plots with extra features marked, coloured by DepthKopy depth.
## Key inputs: Haplotype assemblies, BUSCO, gaps, rDNA, telomeres, DepthKopy CN, DepthCharge tables and SynBad gap ratings.
## Key outputs: Overview plot and detailed plot per chromosome.
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
STEP=13-ChromSynBad
START="[$(date)] Step $STEP"
KEYOUT=$NEWBASE.qcmode.pdf
KEYOUTS="$KEYOUT"
if [ ! -f "$KEYOUT" ]; then

	# Define key new variables

	# Execute code for step
	echo "Generating updated gaps and features files..."
	for BASE in $NEWBASE.hap1 $NEWBASE.hap2; do
		cp -v $BASE.rrna.csv $BASE.ft.csv
		grep bad $BASE.depthcharge.tdt | awk '{print $1","$2","$3",.,black,-2";}' | tee -a $BASE.ft.csv
	done
	#i# Colour sequences by type
	for HAP in hap1 hap2; do
		TFILE=$NEWBASE.$HAP.telomeres.tdt
		TSV=$NEWBASE.$HAP.sequences.tsv
		head -n 1 $TFILE | awk '{print $1"\t"$2"\t"$3"\t"$4"\tCol";}' | tee $TSV
		grep -E "CHR[0-9]+\s" $TFILE | awk '{print $1"\t"$2"\t"$3"\t"$4"\tpalegreen";}' | tee -a $TSV
		grep -E "CHR[0-9]+\." $TFILE | awk '{print $1"\t"$2"\t"$3"\t"$4"\tyellow2";}' | tee -a $TSV
		grep SCF $TFILE | awk '{print $1"\t"$2"\t"$3"\t"$4"\ttan";}' | tee -a $TSV
		grep CTG $TFILE | awk '{print $1"\t"$2"\t"$3"\t"$4"\tivory2";}' | tee -a $TSV
	done
	#i# Update FOFN
	# Generate the FOFN files from a template:
    echo "[$(date)] Generating FOFN files..."
	echo $PREF1 $NEWBASE.hap1 | tee template.fofn
	echo $PREF2 $NEWBASE.hap2 | tee -a template.fofn
	for FOFNDATA in ft.csv-fullft synbadgaps.tsv-synbad sequences.tsv-colseq tidk.tsv-tidk $ODB10.full_table.tsv-busco ; do
		EXT=$(echo $FOFNDATA | awk -F '-' '{print $1;}')
		FOFN=$(echo $FOFNDATA | awk -F '-' '{print $2;}').fofn
		sed "s/$/.$EXT/" template.fofn | tee $FOFN
	done
	#i# CN data
	if [ "$DEPTHKOPYCN" = "TRUE" ]; then
		cat $NEWBASE.hap[12].fulltable.tsv | head -n 1 > $NEWBASE.cndata.tsv
		sed 's/^/$PREF1\t/' $NEWBASE.hap1.fulltable.tsv | grep -v SeqName >> $NEWBASE.cndata.tsv
		sed 's/^/$PREF2\t/' $NEWBASE.hap2.fulltable.tsv | grep -v SeqName >> $NEWBASE.cndata.tsv
	fi

	echo "Generating regdata file for ChromSyn from 1kb+ SynBad hit regions..."
	QRY=$PREF1; HIT=$PREF2
	TSV=$NEWBASE.regdata.tsv
	echo "Genome, HitGenome, SeqName, Start, End, Strand, Hit, HitStart, HitEnd" | sed "s/, /\t/g" | tee $TSV
	awk '$9 > 1000 { print $1"\t"$2"\t"$3"\t"$7"\t"$4"\t"$5"\t"$6; }' $NEWBASE.synbad.qry.full.tdt | sed "s/^/$PREF1\t$PREF2\t/" | grep -v Qry | tee -a $TSV
	awk '$9 > 1000 { print $4"\t"$5"\t"$6"\t"$7"\t"$1"\t"$2"\t"$3; }' $NEWBASE.synbad.hit.full.tdt | sed "s/^/$PREF2\t$PREF1\t/" | grep -v Qry | tee -a $TSV

	echo "Full assembly ChromSyn plot in QC mode with 'good' gaps hidden"
	FOCUS=$QRY
	#SEQORDER=$(grep CHR $NEWBASE.hap1.sequences.tsv | awk '{print $1;}' | sort | tr '\n' ',' | sed 's/,$//')
	#RESTRICT=$(cat $NEWBASE.hap[12].sequences.tsv | grep CHR | awk '{print $1;}' | sort | tr '\n' ',' | sed 's/,$//')
	RESTRICT=$(cat $NEWBASE.hap[12].$ODB10.full_table.tsv | grep CHR | awk '{print $3;}' | sort | uniq | tr '\n' ',' | sed 's/,$//')
	SEQORDER=$(cat $NEWBASE.hap1.$ODB10.full_table.tsv | grep CHR | awk '{print $3;}' | sort | uniq | tr '\n' ',' | sed 's/,$//')
	SETTINGS="pdfwidth=40 orphans=FALSE ticks=1e7 minlen=0 maxregions=8000 regdata=$NEWBASE.regdata.tsv minregion=1 ybleed=1 focus=$FOCUS seqorder=$SEQORDER chromfill=Col regmirror=F sequences=colseq.fofn gaps=synbad.fofn ft=fullft.fofn restrict=$RESTRICT"
	if [ "$DEPTHKOPYCN" = "TRUE" ]; then 
		SETTINGS="$SETTINGS cndata=$NEWBASE.cndata.tsv"
	fi
	echo $SETTINGS
	RUN=$NEWBASE
	BASE=qcmode
	$RSCRIPT $SLIMSUITE/libraries/r/chromsyn.R $SETTINGS basefile=$RUN.$BASE qcmode=T | tee $RUN.$BASE.log

	echo "Chromosome-level ChromSyn plots"
	for CHR in $(grep -E "CHR[0-9]+\s" $NEWBASE.hap1.telomeres.tdt | awk '{print $1;}' | sed "s/$PREF1//" | sort -u); do
		BASE=$CHR
		#RESTRICT=$(cat $NEWBASE.hap[12].sequences.tsv | grep $CHR[^0-9] | awk '{print $1;}' | sort | tr '\n' ',' | sed 's/,$//')
		RESTRICT=$(cat $NEWBASE.hap[12].$ODB10.full_table.tsv | grep $CHR[^0-9] | awk '{print $3;}' | sort | uniq | tr '\n' ',' | sed 's/,$//')
		echo "$CHR: $RESTRICT"
		if [ ! -f "$RUN.$BASE.pdf" ]; then
			$RSCRIPT $SLIMSUITE/libraries/r/chromsyn.R $SETTINGS basefile=$RUN.$BASE restrict=$RESTRICT | tee $RUN.$BASE.log
		fi
	done

	echo -e "$START\n[$(date)] Step $STEP complete" | tee $STEP.done

else
	echo "[$(date)] File found: $KEYOUT - skipping $STEP step" | tee -a $LOG
fi
# Check for key output files - non-fatal if failed to generate
for KEYOUT in $KEYOUTS; do
	if [ ! -f "$KEYOUT" ]; then
		echo "[$(date)] Failed to generate $KEYOUT" | tee -a $LOG
		#exit 1
	fi
done

# Tidy up some of the output files
# Move unwanted files to intermediate directory
for EXT in ft.csv sequences.tsv ; do
	$SHARPCLAW/exec/backupfile.exec $NEWBASE.hap1.$EXT $STEP
	$SHARPCLAW/exec/backupfile.exec $NEWBASE.hap2.$EXT $STEP
done
mv -v *.fofn $STEP/.
mv -v $NEWBASE.CHR* $STEP/.
cp -v $STEP/$NEWBASE.CHR*.pdf .
# Outputs:
# ├── $NEWBASE.CHR*.pdf
# ├── $NEWBASE.qcmode.chromsyn.xlsx
# ├── $NEWBASE.qcmode.pdf
# ├── $NEWBASE.qcmode.png
# ├── $NEWBASE.qcmode.log
if [ "$RUNMODE" = "$STEP" ]; then
	echo "[$(date)] RUNMODE=$RUNMODE -> Exiting run." | tee -a $LOG
	exit 0;
fi


### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
### ~~~~ STEP 14: Diploidocus classification for reduced PreText.               ~~~~ ###
## Goal: Identify probable low-quality junk and repeat contigs to make PreText tidying easier.
## Rationale: Low-quality contigs should probably be dumped, whilst predominantly repeat 
##            contigs will be hard to edit in PretextView.
## Method: Run Diploidocus on each haplotype. Purge_haplotigs is run first.
## Key inputs: BUSCO and BAM files for each haplotype
## - BUSCO=$NEWBASE.$HAP.$ODB10.full_table.tsv
## - BAM=$NEWBASE.$HAP.bam
## - SC Depth = $NEWBASE.$HAP.fastmp.scdepth
## Key outputs: $NEWBASE.hap1.ratings.tdt and $NEWBASE.hap2.ratings.tdt, $NEWBASE.diploidocus.summarise.tdt
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
STEP=14-Diploidocus
START="[$(date)] Step $STEP"
KEYOUT=$NEWBASE.hap2.ratings.tdt
KEYOUTS="$NEWBASE.hap1.ratings.tdt $NEWBASE.hap2.ratings.tdt $NEWBASE.diploidocus.summarise.tdt"
if [ ! -f "$KEYOUT" ]; then

	# Define key new variables

	# Execute code for step
	for HAP in hap1 hap2; do
		GENBASE=$NEWBASE.$HAP
		BUSCO=$GENBASE.$ODB10.full_table.tsv
		BAM=$GENBASE.$READTYPE.bam
		if [ ! -f "$BAM.fastmp.scdepth" ]; then
			echo "$BAM.fastmp.scdepth missing!"
			exit 1
		fi
		SCDEP=$(printf "%.0f" "$(cat $BAM.fastmp.scdepth)")
		#i# Need to pre-run purge_haplotigs:1.1.2.sif
		echo "Running $HAP purge_haplotigs for Diploidocus..."
		# Set and check the files to be made
		PHTSV="$GENBASE.purge.reassignments.tsv"
		PHCSV="$GENBASE.purge.coverage_stats.csv"
		PHCOV="$GENBASE.$READTYPE.bam.gencov"
		if [ -f "$PHTSV" ] && [ -f "$PHCSV" ] && [ -f "$PHCOV" ]; then
			echo "Previous results files found:"
			ls -lrth $PHCOV $PHCSV $PHTSV
		else
			PHLOW=$(($SCDEP/4))
			PHMID=$((3*$SCDEP/4))
			PHHIGH=$((2*$SCDEP))
			echo "$HAP: Low=${PHLOW}X; Mid=${PHMID}X; High=${PHHIGH}X; SC=${SCDEP}X)"
			PHMAX=200
			if [ $PHHIGH gt 100 ]; then
				$PHMAX=$((2*$PHHIGH))
			fi
			PHDIR=purge_$GENBASE
			mkdir $PHDIR; cd $PHDIR
			ln -s ../$BAM .
			ln -s ../$GENBASE.fasta .
			$PURGEHAPLOTIGS hist -b $BAM -g $GENBASE.fasta -t $THREADS -d $PHMAX \
				&& $PURGEHAPLOTIGS cov -i $BAM.gencov -l $PHLOW -m $PHMID -h $PHHIGH -o $GENBASE.purge.coverage_stats.csv -j 80 -s 80 \
				&& $PURGEHAPLOTIGS purge -g $GENBASE.fasta -c $GENBASE.purge.coverage_stats.csv -t $THREADS -o $GENBASE.purge -a 95
			cd $RUNDIR
		fi
		if [ -d "tmp_purge_haplotigs" ]; then
			echo "[$(date)] Deleting tmp_purge_haplotigs/ and contents..."
			rm -rf tmp_purge_haplotigs
		fi
		
		#i# Pre-run bbmap:39.01.sif pileup.sh
		DEPFILE=$GENBASE.depth.tdt
		DEPSTAT=$GENBASE.depth.stats
		if [ -f "$DEPFILE" ]; then
			echo "[$(date)] BBMap pileup.sh results files found: $DEPFILE"
		else
			$SAMTOOLS view -h $BAM | $BBMAPPILEUP in=stdin out=$DEPFILE 2>&1 | tee $DEPSTAT
		fi

		#i# Run Diploidocus
		echo "Running $HAP Diploidocus..."
		SCDEP=$(printf "%.2f" "$(cat $BAM.fastmp.scdepth)")
		# Try with CSI indexing if BAM.bai missing
		if [ ! -f "$BAM.bai" ]; then
			$DIPLOIDOCUS -seqin $GENBASE.fasta -basefile $GENBASE -busco $BUSCO -bam $BAM -scdepth $SCDEP kmerreads=$KMERREADS -threads $THREADS -runmode diploidocus -pretrim F -veccheck F i=-1 v=0 bamcsi=T
		else
			$DIPLOIDOCUS -seqin $GENBASE.fasta -basefile $GENBASE -busco $BUSCO -bam $BAM -scdepth $SCDEP kmerreads=$KMERREADS -threads $THREADS -runmode diploidocus -pretrim F -veccheck F i=-1 v=0
		fi	
	done

	python3 $SLIMSUITE/tools/seqsuite.py summarise batchrun="$NEWBASE.*.diploidocus.fasta,$NEWBASE.*.core.fasta,$NEWBASE.*.quarantine.fasta,$NEWBASE.*.repeats.fasta,$NEWBASE.*.junk.fasta" dna basefile=$NEWBASE.diploidocus i=-1 v=0 log=$LOG
	sed -i 's/.fasta//' $NEWBASE.diploidocus.summarise.tdt
	column -t $NEWBASE.diploidocus.summarise.tdt && echo -e "$START\n[$(date)] Step $STEP complete" | tee $STEP.done


else
	echo "[$(date)] File found: $KEYOUT - skipping $STEP step" | tee -a $LOG
fi
# Check for key output files
for KEYOUT in $KEYOUTS; do
	if [ ! -f "$KEYOUT" ]; then
		echo "[$(date)] Failed to generate $KEYOUT" | tee -a $LOG
		exit 1
	fi
done

# Tidy up some of the output files
rm -rf purge_$NEWBASE.hap[12]/tmp_purge_haplotigs
# Move unwanted files to intermediate directory
for EXT in depth.tdt depth.stats  ; do
	$SHARPCLAW/exec/backupfile.exec $NEWBASE.hap1.$EXT $STEP
	$SHARPCLAW/exec/backupfile.exec $NEWBASE.hap2.$EXT $STEP
done
mv -v $NEWBASE.hap[12].purge.* $STEP/.
for DIP in core junk repeats quarantine ; do
	mv -v $NEWBASE.hap[12].$DIP.fasta* $STEP/.
done

# Outputs:
# ├── $NEWBASE.hap[12].diploidocus.tdt
# ├── $NEWBASE.hap[12].ratings.tdt
# ├── $NEWBASE.hap[12].diploidocus.fasta
if [ "$RUNMODE" = "$STEP" ]; then
	echo "[$(date)] RUNMODE=$RUNMODE -> Exiting run." | tee -a $LOG
	exit 0;
fi


### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
### ~~~~ STEP 15: Reduced PreText generation without repeat scaffolds.          ~~~~ ###
## Goal: Generate cleaner PreText plots without a lot of the confusing contacts and debris.
## Rationale: Removing junk and repeat scaffolds should make it easier to identify and fix scaffolding errors.
## Method: Create BED files from Diploidocus outputs, remove from PT BAM files and regenerate maps.
## Key inputs: Diploidocus outputs and diploid PreText maps
## Key outputs: 
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
if [ ! "$DEV" = "TRUE" ]; then
	echo "[$(date)] Reduced PreText maps currently DEV mode only -> Exiting run." | tee -a $LOG
	exit 0;
fi

STEP=15-ReducedPreText
START="[$(date)] Step $STEP"
KEYOUT=$NEWBASE.dip.diploidocus.map.pretext
KEYOUTS="$KEYOUT"
if [ ! -f "$KEYOUT" ] && [ -f "$NEWBASE.dip.mapped.PT.bam" ]; then

	# Define key new variables
	PTBAM=$NEWBASE.dip.mapped.PT.bam

	# Execute code for step
	echo "Defining BED files for $NEWBASE reduced PreText..."
	cat $NEWBASE.hap[12].ratings.tdt | grep keep | awk '{print $1"\t1\t"$2;}' > $NEWBASE.diploidocus.bed
	cp $NEWBASE.diploidocus.bed $NEWBASE.nojunk.bed
	cat $NEWBASE.hap[12].ratings.tdt | grep quarantine | awk '{print $1"\t1\t"$2;}' >> $NEWBASE.nojunk.bed
	cp $NEWBASE.nojunk.bed $NEWBASE.norepeat.bed
	cat $NEWBASE.hap[12].ratings.tdt | grep junk | awk '{print $1"\t1\t"$2;}' >> $NEWBASE.norepeat.bed
	echo "Reduced PT BAM files and PreText"
	for BED in norepeat nojunk diploidocus; do
		BEDPTBAM=$NEWBASE.dip.$BED.PT.bam
		echo "Generating $BEDPTBAM and PreText snapshots from $PTBAM and $NEWBASE.$BED.bed..."
		$SAMTOOLS view -h -@ $THREADS -L $NEWBASE.$BED.bed $PTBAM > $BEDPTBAM \
			&& ls -lrth $BEDPTBAM \
			&& $SAMTOOLS view -h $BEDPTBAM | \
				$PRETEXTMAP -o "$NEWBASE.dip.$BED.map.pretext" --sortby nosort \
			&& $PRETEXTSNAPSHOT -m "$NEWBASE.dip.$BED.map.pretext" -o "$NEWBASE.dip.$BED.snapshot" --prefix $NEWBASE.dip.${BED}.snapshot.
		ls -lrth $NEWBASE.dip.$BED.map.pretext
	done

	echo -e "$START\n[$(date)] Step $STEP complete" | tee $STEP.done

else
	if [ -f "$NEWBASE.dip.mapped.PT.bam" ]; then
		echo "[$(date)] $NEWBASE.dip.mapped.PT.bam not yet generated - exiting before $STEP step" | tee -a $LOG
		exit 0
	else
		echo "[$(date)] File found: $KEYOUT - skipping $STEP step" | tee -a $LOG
	fi
fi
# Check for key output files
for KEYOUT in $KEYOUTS; do
	if [ ! -f "$KEYOUT" ]; then
		echo "[$(date)] Failed to generate $KEYOUT" | tee -a $LOG
		exit 1
	fi
done

# NOTE: PreText files are cleaned up in the pretext.exec script
# Outputs:
# ├── $NEWBASE.dip.diploidocus.PT.bam
# ├── $NEWBASE.dip.diploidocus.map.pretext
# ├── $NEWBASE.dip.diploidocus.snapshot.tar.gz
# ├── $NEWBASE.dip.nojunk.PT.bam
# ├── $NEWBASE.dip.nojunk.map.pretext
# ├── $NEWBASE.dip.nojunk.snapshot.tar.gz
# ├── $NEWBASE.dip.norepeat.PT.bam
# ├── $NEWBASE.dip.norepeat.map.pretext
# ├── $NEWBASE.dip.norepeat.snapshot.tar.gz
# ├── $NEWBASE.diploidocus.bed
# ├── $NEWBASE.nojunk.bed
# ├── $NEWBASE.norepeat.bed
if [ "$RUNMODE" = "$STEP" ]; then
	echo "[$(date)] RUNMODE=$RUNMODE -> Exiting run." | tee -a $LOG
	exit 0;
fi


