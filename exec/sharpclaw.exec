### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
### ~~~~ STEP 11: DepthKopy CN estimation for ChromSyn plots.                   ~~~~ ###
## Goal: 
## Rationale: 
## Method: 
## Key inputs: 
## Key outputs: 
### ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ###
STEP=DepthKopy
START="[$(date)] Step $STEP"
KEYOUT=$NEWBASE.hap2.fulltable.tsv
KEYOUTS="$NEWBASE.hap1.fulltable.tsv $KEYOUT"
if [ "$DEPTHKOPYCN" = "TRUE" ] && [ ! -f "$KEYOUT" ]; then

# Define key new variables
#i# DepthKopy can run out of memory with 32 threads and 56G memory. 
#i# Reducing the thread count here. Might need to set as a new config setting.
#i# Will try re-running without the KAT data if fails to complete.
FORKS=$(($NCPU/2))
# Execute code for step
#i# Run DepthKopy
for HAP in hap1 hap2; do
  if [ ! -f "$NEWBASE.$HAP.fulltable.tsv" ]; then
    GENBASE=$NEWBASE.$HAP
    BUSCO=$GENBASE.$ODB10.full_table.tsv
    BAM=$GENBASE.$READTYPE.bam
    CONTIGS=$GENBASE.contigs.tdt
    ALTGENOME=$NEWBASE.hap1.fasta
    if [ "$HAP" == "hap1" ]; then
    	ALTGENOME=$NEWBASE.hap2.fasta
    fi
    # Try with CSI indexing if BAM.bai missing
    if [ ! -f "$BAM.bai" ]; then
    	$DEPTHKOPY -threads $FORKS -seqin $GENBASE.fasta -basefile $GENBASE -busco $BUSCO -bam $BAM kmerreads="$KMERREADS" kmeralt=$ALTGENOME regfile=Contigs:$CONTIGS reghead=seqname,start,end i=-1 v=0 bamcsi=T
    else
		$DEPTHKOPY -threads $FORKS -seqin $GENBASE.fasta -basefile $GENBASE -busco $BUSCO -bam $BAM kmerreads="$KMERREADS" kmeralt=$ALTGENOME regfile=Contigs:$CONTIGS reghead=seqname,start,end i=-1 v=0
	fi
	# Try re-running without the KAT data if the run failed.
    if [ ! -f "$NEWBASE.$HAP.fulltable.csv" ]; then
    	echo "DepthKopy run failed. Possible memory problems? Will try without KAT data. If problems remain, try increasing memory requested."
        if [ ! -f "$BAM.bai" ]; then
    		$DEPTHKOPY -threads $FORKS -seqin $GENBASE.fasta -basefile $GENBASE -busco $BUSCO -bam $BAM kmerreads= kmeralt=None kmerself=F regfile=Contigs:$CONTIGS reghead=seqname,start,end i=-1 v=0 bamcsi=T
	    else
			$DEPTHKOPY -threads $FORKS -seqin $GENBASE.fasta -basefile $GENBASE -busco $BUSCO -bam $BAM kmerreads= kmeralt=None kmerself=F regfile=Contigs:$CONTIGS reghead=seqname,start,end i=-1 v=0
		fi
	fi
	
  fi
done

touch $STEP.done

else
	echo "[$(date)] File found: $KEYOUT - skipping $STEP step" | tee -a $LOG
fi
# Check for key output files
for KEYOUT in $KEYOUTS; do
	if [ ! -f "$KEYOUT" ]; then
		echo "[$(date)] WARNING: Failed to generate $KEYOUT - some later stages may be affected" | tee -a $LOG
	fi
done

